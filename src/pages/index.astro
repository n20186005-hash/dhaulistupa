---
import BaseLayout from '../layouts/BaseLayout.astro';
const title='ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ | ଭୁବନେଶ୍ୱର, ଓଡ଼ିଶା ପର୍ଯ୍ୟଟକ ଗାଇଡ୍';
const description='ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ ପାଇଁ ସ୍ୱାଧୀନ ଓଡ଼ିଆ ଗାଇଡ୍—ଇତିହାସ, ପ୍ରବେଶ ଶୁଳ୍କ, ସମୟ, ଯାତାୟାତ, ପାର୍କିଂ, ନିକଟସ୍ଥ ସ୍ଥାନ, ଖାଦ୍ୟ, ମାନଚିତ୍ର ଓ ପ୍ରଶ୍ନୋତ୍ତର।';
const site=Astro.site?.toString().replace(/\/$/,'');
const pageUrl=site?`${site}/`:undefined;
const attraction={
 '@context':'https://schema.org','@type':['TouristAttraction','LandmarksOrHistoricalBuildings'],
 name:'ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ',alternateName:['ଧଉଳିଗିରି ଶାନ୍ତି ସ୍ତୂପ','ପିସ୍ ପାଗୋଡା'],description,
 ...(pageUrl?{url:pageUrl}:{}),
 address:{'@type':'PostalAddress',streetAddress:'ପୁରୀ ରୋଡ୍, ଧଉଳି',addressLocality:'ଭୁବନେଶ୍ୱର',addressRegion:'ଓଡ଼ିଶା',postalCode:'751002',addressCountry:'IN'},
 geo:{'@type':'GeoCoordinates',latitude:20.19245,longitude:85.839584},
 aggregateRating:{'@type':'AggregateRating',ratingValue:4.5,reviewCount:28223,bestRating:5,worstRating:1},
 openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'06:30',closes:'18:30'}],
 isAccessibleForFree:true,
 sameAs:['https://odishatourism.gov.in/content/tourism/en/discover/attractions/buddhist-sites/dhauligiri.html','https://www.incredibleindia.gov.in/en/odisha/bhubaneswar/dhauligiri-hills','https://maps.app.goo.gl/7qV2Q1HFgcDgmCJj7']
};
const faqs=[
 ['ଧଉଳି ଶାନ୍ତି ସ୍ତୂପରେ ପ୍ରବେଶ ଶୁଳ୍କ ଅଛି କି?','ସ୍ତୂପ ପ୍ରାଙ୍ଗଣକୁ ସାଧାରଣ ପ୍ରବେଶ ପାଇଁ ସାଧାରଣତଃ ଟିକେଟ୍ ଲାଗେ ନାହିଁ। ଯାନ ପାର୍କିଂ କିମ୍ବା ବିଶେଷ କାର୍ଯ୍ୟକ୍ରମର ଶୁଳ୍କ ଅଲଗା ହୋଇପାରେ।'],
 ['କେତେ ସମୟ ରଖିବା ଭଲ?','ସ୍ତୂପ, ଦୃଶ୍ୟ, ଶିଳାଲେଖ ଅଞ୍ଚଳ ଏବଂ ଶାନ୍ତ ଭ୍ରମଣ ପାଇଁ ୧–୨ ଘଣ୍ଟା ରଖିବା ସୁବିଧାଜନକ।'],
 ['ସର୍ବୋତ୍ତମ ଭ୍ରମଣ ସମୟ କେବେ?','ଅକ୍ଟୋବରରୁ ମାର୍ଚ୍ଚ ମଧ୍ୟରେ ତାପମାତ୍ରା ତୁଳନାମୂଳକ ଆରାମଦାୟକ। ଗ୍ରୀଷ୍ମରେ ସକାଳ ବା ସନ୍ଧ୍ୟା ପୂର୍ବର ସମୟ ବାଛନ୍ତୁ।'],
 ['ଭୁବନେଶ୍ୱରରୁ କିପରି ଯିବେ?','ପୁରୀ ରୋଡ୍ ଦିଗରେ ଟ୍ୟାକ୍ସି, ଆପ୍ କ୍ୟାବ୍, ଅଟୋ ବା ନିଜସ୍ୱ ଯାନରେ ଯିବା ସହଜ। ସହର କେନ୍ଦ୍ରରୁ ଧଉଳି ପ୍ରାୟ ୮ କିମି ଦକ୍ଷିଣରେ।'],
 ['ଏଠାରେ ପାର୍କିଂ ମିଳେ କି?','ପାହାଡ଼ ଉପରକୁ ଯିବା ରାସ୍ତାର ନିକଟରେ ନିର୍ଦ୍ଦିଷ୍ଟ ଯାନ ରଖିବା ସୁବିଧା ମିଳେ। ଛୁଟି ଦିନ ଓ ପର୍ବରେ ସ୍ଥାନ ସୀମିତ ହୋଇପାରେ; ସ୍ଥାନୀୟ ସଙ୍କେତ ଅନୁସରଣ କରନ୍ତୁ।'],
 ['ଅଶୋକଙ୍କ ଶିଳାଲେଖ କେଉଁଠାରେ?','ଧଉଳି ପାହାଡ଼ ଅଞ୍ଚଳରେ ଅଶୋକଙ୍କ ପ୍ରମୁଖ ଶିଳାଲେଖ ଏବଂ ଶିଳାକଟା ହାତୀ ରହିଛି। ସ୍ତୂପ ଭ୍ରମଣ ସହ ଏହାକୁ ଏକେ ଐତିହାସିକ ପରିଦୃଶ୍ୟର ଅଂଶ ଭାବେ ଦେଖନ୍ତୁ।']
];
const faqLd={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<BaseLayout {title} {description} path="/" image="/images/dhauli-hero.jpg" jsonLd={[attraction,faqLd]}>
<section class="hero"><div class="hero-media"><img src="/images/dhauli-hero.jpg" width="1280" height="855" alt="ଧଉଳି ପାହାଡ଼ ଉପରେ ଧଳା ଶାନ୍ତି ସ୍ତୂପ" fetchpriority="high"/></div><div class="wrap hero-inner"><p class="kicker">ଭୁବନେଶ୍ୱର · ଖୋର୍ଦ୍ଧା · ଓଡ଼ିଶା</p><h1>ଧଉଳି ଶାନ୍ତି<br/>ସ୍ତୂପ</h1><p>କଳିଙ୍ଗ ଯୁଦ୍ଧର ସ୍ମୃତିଭୂମି ଉପରେ ଉଠିଥିବା ଏକ ଧଳା ଶାନ୍ତି ପାଗୋଡା—ଯେଉଁଠାରେ ଅଶୋକଙ୍କ ହିଂସାରୁ ଧର୍ମ ଓ ଅହିଂସା ପ୍ରତି ମୁଖାବର୍ତ୍ତନର କାହାଣୀ, ବୌଦ୍ଧ ପ୍ରତୀକ ଏବଂ ଦୟା ନଦୀର ଦୃଶ୍ୟ ଏକାତ୍ମ ହୋଇଥାଏ।</p><div class="hero-actions"><a class="btn" href="#visit">ଭ୍ରମଣ ପ୍ରସ୍ତୁତି</a><a class="btn alt" href="#map">ମାନଚିତ୍ର ଦେଖନ୍ତୁ</a></div></div></section>
<div class="wrap fact-strip"><div class="card facts"><div class="fact"><b>୪.୫ / ୫</b><span>ଗୁଗୁଲ୍ ମାନଚିତ୍ର ମୂଲ୍ୟାୟନ</span></div><div class="fact"><b>୨୮,୨୨୩</b><span>ସମୀକ୍ଷା ସଂଖ୍ୟା</span></div><div class="fact"><b>୬:୩୦–୧୮:୩୦</b><span>ସାଧାରଣ ଦର୍ଶନ ସମୟ</span></div><div class="fact"><b>ପ୍ରବେଶ ମୁକ୍ତ</b><span>ସାଧାରଣ ପ୍ରବେଶ</span></div><div class="fact"><b>5RRQ+XQ</b><span>ଧଉଳି, ଓଡ଼ିଶା</span></div></div></div>
<section id="history" class="section"><div class="wrap story-grid"><figure class="dome-panel"><img src="/images/dhauli-front.jpg" width="1280" height="855" alt="ଧଉଳି ଶାନ୍ତି ସ୍ତୂପର ସିଢ଼ି ଓ ଧଳା ଗୁମ୍ବଜ" loading="lazy"/><figcaption class="caption">ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ · ପାହାଡ଼ ଶୀର୍ଷର ଶାନ୍ତି ସ୍ମାରକ</figcaption></figure><div><p class="eyebrow">ଯୁଦ୍ଧରୁ ଶାନ୍ତି</p><h2 class="title">କଳିଙ୍ଗର ସ୍ମୃତି, ଶାନ୍ତିର ସନ୍ଦେଶ</h2><p class="lead">ଓଡ଼ିଶା ପର୍ଯ୍ୟଟନ ଅନୁସାରେ ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ ୧୯୭୨ ମସିହାରେ ଜାପାନ ବୁଦ୍ଧ ସଂଘ ଓ କଳିଙ୍ଗ ନିପ୍ପନ୍ ବୁଦ୍ଧ ସଂଘର ସହଯୋଗରେ ନିର୍ମିତ। ଏହା କଳିଙ୍ଗ ଯୁଦ୍ଧ ପରବର୍ତ୍ତୀ ଅହିଂସା ଓ ଶାନ୍ତିର ଐତିହାସିକ ସନ୍ଦେଶକୁ ସ୍ମରଣ କରାଏ।</p><div class="timeline"><div class="time-item"><strong>୨୬୧ ଖ୍ରୀ.ପୂ.</strong><p>କଳିଙ୍ଗ ଯୁଦ୍ଧ ସହ ଧଉଳି ଅଞ୍ଚଳର ଐତିହାସିକ ସମ୍ପର୍କ; ଅଶୋକଙ୍କ ଶାସନ ଦୃଷ୍ଟିଭଙ୍ଗୀର ଗଭୀର ପରିବର୍ତ୍ତନ ସହ ଏହି ସ୍ଥାନକୁ ଯୋଡ଼ାଯାଏ।</p></div><div class="time-item"><strong>ଶିଳାଲେଖ</strong><p>ଧଉଳିର ଅଶୋକ ଶିଳାଲେଖ ଶାସନ, ଲୋକକଲ୍ୟାଣ ଓ ନୈତିକ ଦାୟିତ୍ୱ ବିଷୟରେ ଆଦେଶ ରଖିଛି; ନିକଟରେ ଶିଳାକଟା ହାତୀ ମଧ୍ୟ ରହିଛି।</p></div><div class="time-item"><strong>୧୯୭୨</strong><p>ଆଧୁନିକ ଶାନ୍ତି ସ୍ତୂପ ନିର୍ମାଣ—ଧଳା ଗୁମ୍ବଜ, ଛତ୍ର, ସିଂହ ମୂର୍ତ୍ତି ଏବଂ ବୁଦ୍ଧ ଜୀବନ ଓ ଅଶୋକଙ୍କ ପରିବର୍ତ୍ତନକୁ ଉପସ୍ଥାପନ କରୁଥିବା ରିଲିଫ୍ ପ୍ୟାନେଲ୍ ସହ।</p></div></div></div></div></section>
<section id="visit" class="section"><div class="wrap"><p class="eyebrow">ଯିବା ପୂର୍ବରୁ</p><h2 class="title">ଭ୍ରମଣର ମୁଖ୍ୟ ସୂଚନା</h2><div class="visit-grid"><article class="card visit-card"><span class="num">୦୧</span><h3>ଟିକେଟ୍ / ଖର୍ଚ୍ଚ</h3><p>ସାଧାରଣ ପ୍ରବେଶ ପାଇଁ ଶୁଳ୍କ ନାହିଁ ବୋଲି ରାଜ୍ୟ ପର୍ଯ୍ୟଟନ ସୂଚନା ଦର୍ଶାଏ। ପାର୍କିଂ କିମ୍ବା ବିଶେଷ କାର୍ଯ୍ୟକ୍ରମର ଖର୍ଚ୍ଚ ପରିବର୍ତ୍ତନଶୀଳ।</p></article><article class="card visit-card"><span class="num">୦୨</span><h3>ପାର୍କିଂ</h3><p>ପାହାଡ଼ ଶୀର୍ଷକୁ ଯାଉଥିବା ରାସ୍ତା ପାଖରେ ଯାନ ରଖିବା ବ୍ୟବସ୍ଥା ମିଳେ। ଭିଡ଼ ଦିନରେ ସକାଳେ ପହଞ୍ଚିବା ଭଲ।</p></article><article class="card visit-card"><span class="num">୦୩</span><h3>ସର୍ବୋତ୍ତମ ସମୟ</h3><p>ଅକ୍ଟୋବର–ମାର୍ଚ୍ଚ ଆରାମଦାୟକ ଋତୁ। ବର୍ଷର ଅନ୍ୟ ସମୟରେ ସକାଳ ବା ସୂର୍ଯ୍ୟାସ୍ତ ପୂର୍ବର ହାଲୁକା ସମୟ ବାଛନ୍ତୁ।</p></article><article class="card visit-card"><span class="num">୦୪</span><h3>କେତେ ସମୟ?</h3><p>୧–୨ ଘଣ୍ଟା ରଖିଲେ ସ୍ତୂପ, ଦୃଶ୍ୟବିନ୍ଦୁ ଓ ନିକଟସ୍ଥ ଐତିହାସିକ ଅଂଶ ଶାନ୍ତିରେ ଦେଖିପାରିବେ।</p></article></div></div></section>
<section class="section"><div class="wrap"><p class="eyebrow">ଦୃଶ୍ୟ ଓ ପ୍ରତୀକ</p><h2 class="title">ଧଳା ଗୁମ୍ବଜ, ବୁଦ୍ଧ ମୂର୍ତ୍ତି, ଦୟା ଉପତ୍ୟକା</h2><div class="gallery"><figure><img src="/images/dhauli-detail.jpg" width="1280" height="855" alt="ଶାନ୍ତି ସ୍ତୂପର ଧଳା ଗୁମ୍ବଜ ଓ ସୁବର୍ଣ୍ଣ ଅଳଙ୍କାର" loading="lazy"/><figcaption>ଶାନ୍ତି ସ୍ତୂପର ସ୍ଥାପତ୍ୟ ଓ ସିଂହ ଅଳଙ୍କାର</figcaption></figure><figure><img src="/images/dhauli-buddha.jpg" width="960" height="1280" alt="ଧଉଳି ଶାନ୍ତି ସ୍ତୂପର ବୁଦ୍ଧ ମୂର୍ତ୍ତି" loading="lazy"/><figcaption>ସ୍ତୂପ ପରିକ୍ରମାରେ ବୁଦ୍ଧ ଜୀବନର ପ୍ରତୀକାତ୍ମକ ରୂପ</figcaption></figure><figure><img src="/images/dhauli-view.jpg" width="1280" height="855" alt="ଧଉଳି ପାହାଡ଼ରୁ ଦୟା ନଦୀ ଦିଗର ଦୃଶ୍ୟ" loading="lazy"/><figcaption>ଧଉଳି ପାହାଡ଼ରୁ ସମତଳ ଭୂମି ଓ ଦୟା ନଦୀ ଦିଗ</figcaption></figure></div></div></section>
<section id="transport" class="section"><div class="wrap"><p class="eyebrow">ବିସ୍ତୃତ ଯାତାୟାତ</p><h2 class="title">ଭୁବନେଶ୍ୱରରୁ ଧଉଳି ପହଞ୍ଚିବା</h2><div class="transport-grid"><article class="card route"><h3>ବିମାନ ଓ ରେଳରୁ</h3><ul><li>ନିକଟତମ ବିମାନବନ୍ଦର: ବିଜୁ ପଟ୍ଟନାୟକ ଆନ୍ତର୍ଜାତୀୟ ବିମାନବନ୍ଦର, ଭୁବନେଶ୍ୱର।</li><li>ନିକଟତମ ପ୍ରମୁଖ ରେଳଷ୍ଟେସନ୍: ଭୁବନେଶ୍ୱର।</li><li>ଦୁଇ ସ୍ଥାନରୁ ଟ୍ୟାକ୍ସି/ଆପ୍ କ୍ୟାବ୍/ଅଟୋ ନେଇ ପୁରୀ ରୋଡ୍ ଦିଗରେ ଧଉଳି ଯାଇପାରିବେ।</li></ul></article><article class="card route"><h3>ସଡ଼କ ମାର୍ଗରେ</h3><ul><li>ଭୁବନେଶ୍ୱର ସହରରୁ ପୁରୀ ରୋଡ୍ ମାର୍ଗ ସର୍ବାଧିକ ସରଳ ରୁଟ୍।</li><li>ସହରରୁ ଧଉଳି ପ୍ରାୟ ୮ କିମି ଦକ୍ଷିଣରେ; ଯାତ୍ରା ସମୟ ଟ୍ରାଫିକ୍ ଉପରେ ନିର୍ଭର କରେ।</li><li>ଶେଷ ଉପରମୁଖୀ ରାସ୍ତାରେ ପଦଚାରୀ ଓ ଯାନ ଭିଡ଼ ଥାଇପାରେ—ଧୀରେ ଚାଲନ୍ତୁ ଏବଂ ସ୍ଥାନୀୟ ନିର୍ଦ୍ଦେଶ ମାନନ୍ତୁ।</li></ul></article></div></div></section>
<section id="map" class="section"><div class="wrap"><p class="eyebrow">ସ୍ଥାନ</p><h2 class="title">ଗୁଗୁଲ୍ ମାନଚିତ୍ର</h2><p class="lead">ଠିକଣା: ପୁରୀ ରୋଡ୍, ଭୁବନେଶ୍ୱର, ଧଉଳି, ଓଡ଼ିଶା ୭୫୧୦୦୨ · ପ୍ଲସ୍ କୋଡ୍ 5RRQ+XQ</p><div class="map-wrap"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6660.314840046148!2d85.83689107708808!3d20.192428481255828!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a1909ff47a6b839%3A0x41e4c5c0a7d51f9f!2sDhauli%20Shanti%20Stupa!5e1!3m2!1sor!2sin!4v1788188818750!5m2!1sor!2sin" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ ମାନଚିତ୍ର"></iframe></div></div></section>
<section class="section"><div class="wrap"><p class="eyebrow">ନିକଟସ୍ଥ ଦର୍ଶନୀୟ ସ୍ଥାନ</p><h2 class="title">ଧଉଳି ସହ ଏକେ ଦିନରେ</h2><div class="nearby"><article class="card place"><div class="distance">ନିକଟେ</div><div><h3>ଅଶୋକ ଶିଳାଲେଖ ଓ ଶିଳାକଟା ହାତୀ</h3><p>ଧଉଳିର ମୁଖ୍ୟ ଐତିହାସିକ ପରିଚୟ; ଅଶୋକଙ୍କ ଶାସନ ଆଦର୍ଶ ଓ ବୌଦ୍ଧ ସମ୍ପର୍କକୁ ବୁଝିବା ପାଇଁ ଅବଶ୍ୟ ଦେଖନ୍ତୁ।</p></div></article><article class="card place"><div class="distance">୧୦ କିମି</div><div><h3>ଲିଙ୍ଗରାଜ ମନ୍ଦିର ଅଞ୍ଚଳ</h3><p>ପୁରୁଣା ଭୁବନେଶ୍ୱରର କଳିଙ୍ଗ ସ୍ଥାପତ୍ୟ ଐତିହ୍ୟର ପ୍ରମୁଖ କେନ୍ଦ୍ର। ପ୍ରବେଶ ନିୟମ ଧର୍ମୀୟ ହୋଇପାରେ—ପୂର୍ବରୁ ଯାଞ୍ଚ କରନ୍ତୁ।</p></div></article><article class="card place"><div class="distance">୧୧ କିମି</div><div><h3>ରାଜାରାଣୀ ମନ୍ଦିର</h3><p>ସୁକ୍ଷ୍ମ ଶିଳ୍ପକାର୍ଯ୍ୟ ଓ ଶାନ୍ତ ପରିବେଶ ସହିତ ଭୁବନେଶ୍ୱରର ଏକ ପରିଚିତ ଐତିହ୍ୟ ସ୍ଥାନ।</p></div></article><article class="card place"><div class="distance">୧୫ କିମି</div><div><h3>ପିପିଲି</h3><p>ଓଡ଼ିଶାର ଆପ୍ଲିକେ କାରୁକାର୍ଯ୍ୟ ପରମ୍ପରା ପାଇଁ ପରିଚିତ; ପୁରୀ ମାର୍ଗରେ ଧଉଳି ପରେ ଯୋଡ଼ିବା ସହଜ।</p></div></article></div></div></section>
<section class="section"><div class="wrap food-band"><div><p class="eyebrow" style="color:#f0c671">ନିକଟର ଖାଦ୍ୟ</p><h2 class="title">ଧଉଳି ସ୍କ୍ୱାର୍ ଓ ପୁରୀ ରୋଡ୍‌ରେ ସ୍ଥାନୀୟ ସ୍ୱାଦ</h2><p>ଏହା କୌଣସି ବ୍ୟବସାୟିକ ସୁପାରିଶ ନୁହେଁ। ଧଉଳି ତଳଭାଗ ଓ ପୁରୀ ରୋଡ୍‌ରେ ଛୋଟ ଖାଦ୍ୟ ଦୋକାନ, ଚା, ଶୀତଳ ପାନୀୟ ଓ ଓଡ଼ିଆ ଭୋଜନ ମିଳିପାରେ। ସ୍ୱଚ୍ଛତା, ତାଜାପନ ଓ ଦର ସ୍ଥାନରେ ଯାଞ୍ଚ କରନ୍ତୁ।</p></div><div class="food-tags"><span>ଦହିବରା ଆଳୁଦମ</span><span>ଡାଲମା</span><span>ପଖାଳ</span><span>ଛେନାପୋଡ଼</span><span>ଚା</span><span>ନଡ଼ିଆ ପାଣି</span></div></div></section>
<section id="faq" class="section"><div class="wrap"><p class="eyebrow">ସାଧାରଣ ପ୍ରଶ୍ନ</p><h2 class="title">ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ ପ୍ରଶ୍ନୋତ୍ତର</h2><div class="faq">{faqs.map(([q,a])=><details class="card"><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
<section class="section"><div class="wrap"><p class="eyebrow">ତଥ୍ୟ ଯାଞ୍ଚ ପାଇଁ</p><h2 class="title">ଅଧିକୃତ ଓ ସାର୍ବଜନୀନ ସୂତ୍ର</h2><p class="lead">ଯାତ୍ରା ପୂର୍ବରୁ ସମୟ, କାର୍ଯ୍ୟକ୍ରମ ଓ ପ୍ରବେଶ ବ୍ୟବସ୍ଥାର ତାଜା ସୂଚନା ଅଧିକୃତ ଚ୍ୟାନେଲରୁ ନିଶ୍ଚିତ କରନ୍ତୁ।</p><div class="sources"><a class="source-link" href="https://odishatourism.gov.in/content/tourism/en/discover/attractions/buddhist-sites/dhauligiri.html" rel="noopener noreferrer">ଓଡ଼ିଶା ପର୍ଯ୍ୟଟନ · ଧଉଳିଗିରି</a><a class="source-link" href="https://www.incredibleindia.gov.in/en/odisha/bhubaneswar/dhauligiri-hills" rel="noopener noreferrer">ଭାରତ ପର୍ଯ୍ୟଟନ · ଧଉଳିଗିରି ପାହାଡ଼</a><a class="source-link" href="https://www.bmc.gov.in/" rel="noopener noreferrer">ଭୁବନେଶ୍ୱର ମହାନଗର ନିଗମ</a><a class="source-link" href="https://maps.app.goo.gl/7qV2Q1HFgcDgmCJj7" rel="noopener noreferrer">ଗୁଗୁଲ୍ ମାନଚିତ୍ର ସ୍ଥାନ</a></div></div></section>
