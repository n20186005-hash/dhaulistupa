---
import BaseLayout from '../layouts/BaseLayout.astro';
import { entity } from '../config';
const BASE=Astro.site?.toString().replace(/\/$/,'');
const abs=(p:string)=>BASE?new URL(p,`${BASE}/`).toString():undefined;
const pageUrl=BASE?`${BASE}/`:undefined;
const {fullName,shortName,city,state,country}=entity;
const title=`${fullName} (${city}) · ${entity.fullNameLocal} | ${entity.stateLocal} ପର୍ଯ୍ୟଟକ ଗାଇଡ୍`;
const description=`${entity.fullNameLocal} (${fullName}), ${entity.cityLocal} — ଇତିହାସ, ସମୟ, ପ୍ରବେଶ, ଯାତାୟାତ, ପାର୍କିଂ, ନିକଟସ୍ଥ ସ୍ଥାନ, ମାନଚିତ୍ର ଓ ପ୍ରଶ୍ନୋତ୍ତର। Location map, opening hours and travel tips.`;
const images:string[]=['/images/dhauli-hero.jpg','/images/dhauli-front.jpg','/images/dhauli-detail.jpg','/images/dhauli-buddha.jpg','/images/dhauli-view.jpg'].map((p)=>abs(p)).filter((u):u is string=>!!u);
const attraction={
 '@context':'https://schema.org','@type':['TouristAttraction','LandmarksOrHistoricalBuildings'],
 ...(BASE?{'@id':`${BASE}/#attraction`}:{}),
 name:fullName,
 alternateName:[entity.fullNameLocal,'ଧଉଳିଗିରି ଶାନ୍ତି ସ୍ତୂପ','ପିସ୍ ପାଗୋଡା',shortName,`${city} ${fullName}`,...entity.alsoKnownAs],
 description:`Comprehensive visitor guide to ${fullName}, the peace pagoda of ${city}, ${state}, ${country}.`,
 ...(pageUrl?{url:pageUrl}:{}),
 ...(images.length?{image:images}:{}),
 address:{'@type':'PostalAddress',streetAddress:entity.streetAddress,addressLocality:city,addressRegion:state,postalCode:entity.postalCode,addressCountry:entity.countryCode},
 geo:{'@type':'GeoCoordinates',latitude:entity.latitude,longitude:entity.longitude},
 hasMap:entity.mapsUrl,
 containedInPlace:{'@type':'City',name:city,containedInPlace:{'@type':'AdministrativeArea',name:state,containedInPlace:{'@type':'Country',name:country}}},
 aggregateRating:{'@type':'AggregateRating',ratingValue:entity.ratingValue,reviewCount:entity.reviewCount,bestRating:5,worstRating:1},
 openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:entity.hours.opens,closes:entity.hours.closes}],
 isAccessibleForFree:true,
 sameAs:[entity.mapsUrl,...entity.sources.map((s)=>s.url)]
};
const breadcrumb=BASE?{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
 {'@type':'ListItem',position:1,name:country,item:`${BASE}/`},
 {'@type':'ListItem',position:2,name:state,item:`${BASE}/#about`},
 {'@type':'ListItem',position:3,name:city,item:`${BASE}/#map`},
 {'@type':'ListItem',position:4,name:fullName}
]}:undefined;
const faqs=[
 [`${fullName} କେଉଁଠାରେ ଅବସ୍ଥିତ? Where is ${fullName} located?`,`${fullName} (${entity.fullNameLocal}) ପୁରୀ ରୋଡ୍, ଧଉଳି, ${entity.cityLocal}, ${entity.stateLocal} ${entity.postalCode}, ${entity.countryLocal} (Plus Code ${entity.plusCode})ରେ ଅବସ୍ଥିତ। ${fullName} is located in ${city}, ${state}, ${country}.`],
 [`${fullName} ଦର୍ଶନ ମାଗଣା କି? Is ${shortName} free to visit?`,`ହଁ। ${fullName} ଏକ ସାର୍ବଜନୀନ ସ୍ମାରକ ସ୍ଥଳ; ସାଧାରଣ ପ୍ରବେଶ ବର୍ଷସାରା ମାଗଣା। Yes, ${fullName} is a public space and is free to visit year-round.`],
 ['ଧଉଳି ଶାନ୍ତି ସ୍ତୂପରେ ପ୍ରବେଶ ଶୁଳ୍କ ଅଛି କି?','ସ୍ତୂପ ପ୍ରାଙ୍ଗଣକୁ ସାଧାରଣ ପ୍ରବେଶ ପାଇଁ ସାଧାରଣତଃ ଟିକେଟ୍ ଲାଗେ ନାହିଁ। ଯାନ ପାର୍କିଂ କିମ୍ବା ବିଶେଷ କାର୍ଯ୍ୟକ୍ରମର ଶୁଳ୍କ ଅଲଗା ହୋଇପାରେ।'],
 ['କେତେ ସମୟ ରଖିବା ଭଲ?','ସ୍ତୂପ, ଦୃଶ୍ୟ, ଶିଳାଲେଖ ଅଞ୍ଚଳ ଏବଂ ଶାନ୍ତ ଭ୍ରମଣ ପାଇଁ ୧–୨ ଘଣ୍ଟା ରଖିବା ସୁବିଧାଜନକ।'],
 ['ସର୍ବୋତ୍ତମ ଭ୍ରମଣ ସମୟ କେବେ?','ଅକ୍ଟୋବରରୁ ମାର୍ଚ୍ଚ ମଧ୍ୟରେ ତାପମାତ୍ରା ତୁଳନାମୂଳକ ଆରାମଦାୟକ। ଗ୍ରୀଷ୍ମରେ ସକାଳ ବା ସନ୍ଧ୍ୟା ପୂର୍ବର ସମୟ ବାଛନ୍ତୁ।'],
 ['ଭୁବନେଶ୍ୱରରୁ କିପରି ଯିବେ?','ପୁରୀ ରୋଡ୍ ଦିଗରେ ଟ୍ୟାକ୍ସି, ଆପ୍ କ୍ୟାବ୍, ଅଟୋ ବା ନିଜସ୍ୱ ଯାନରେ ଯିବା ସହଜ। ସହର କେନ୍ଦ୍ରରୁ ଧଉଳି ପ୍ରାୟ ୮ କିମି ଦକ୍ଷିଣରେ।'],
 ['ଏଠାରେ ପାର୍କିଂ ମିଳେ କି?','ପାହାଡ଼ ଉପରକୁ ଯିବା ରାସ୍ତାର ନିକଟରେ ନିର୍ଦ୍ଦିଷ୍ଟ ଯାନ ରଖିବା ସୁବିଧା ମିଳେ। ଛୁଟି ଦିନ ଓ ପର୍ବରେ ସ୍ଥାନ ସୀମିତ ହୋଇପାରେ; ସ୍ଥାନୀୟ ସଙ୍କେତ ଅନୁସରଣ କରନ୍ତୁ।'],
 ['ଅଶୋକଙ୍କ ଶିଳାଲେଖ କେଉଁଠାରେ?','ଧଉଳି ପାହାଡ଼ ଅଞ୍ଚଳରେ ଅଶୋକଙ୍କ ପ୍ରମୁଖ ଶିଳାଲେଖ ଏବଂ ଶିଳାକଟା ହାତୀ ରହିଛି। ସ୍ତୂପ ଭ୍ରମଣ ସହ ଏହାକୁ ଏକେ ଐତିହାସିକ ପରିଦୃଶ୍ୟର ଅଂଶ ଭାବେ ଦେଖନ୍ତୁ।']
];
const faqLd={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<BaseLayout {title} {description} path="/" image="/images/dhauli-hero.jpg" imageAlt={`${fullName} - main view in ${city}, ${country}`} ogTitle={`${fullName} - ${city} Travel Guide`} jsonLd={breadcrumb?[attraction,faqLd,breadcrumb]:[attraction,faqLd]} aboutAttraction={true}>
<section class="hero"><div class="hero-media"><img src="/images/dhauli-hero.jpg" width="1280" height="855" alt={`${fullName} - main view in ${city}, ${country} | ଧଉଳି ପାହାଡ଼ ଉପରେ ଧଳା ଶାନ୍ତି ସ୍ତୂପ`} fetchpriority="high"/></div><div class="wrap hero-inner"><p class="kicker">ଭୁବନେଶ୍ୱର · ଖୋର୍ଦ୍ଧା · ଓଡ଼ିଶା</p><h1>ଧଉଳି ଶାନ୍ତି<br/>ସ୍ତୂପ<span class="h1-alt">{`${fullName} (${city})`}</span></h1><p>କଳିଙ୍ଗ ଯୁଦ୍ଧର ସ୍ମୃତିଭୂମି ଉପରେ ଉଠିଥିବା ଏକ ଧଳା ଶାନ୍ତି ପାଗୋଡା—ଯେଉଁଠାରେ ଅଶୋକଙ୍କ ହିଂସାରୁ ଧର୍ମ ଓ ଅହିଂସା ପ୍ରତି ମୁଖାବର୍ତ୍ତନର କାହାଣୀ, ବୌଦ୍ଧ ପ୍ରତୀକ ଏବଂ ଦୟା ନଦୀର ଦୃଶ୍ୟ ଏକାତ୍ମ ହୋଇଥାଏ।</p><div class="hero-actions"><a class="btn" href="#visit">ଭ୍ରମଣ ପ୍ରସ୍ତୁତି</a><a class="btn alt" href="#map">ମାନଚିତ୍ର ଦେଖନ୍ତୁ</a></div></div></section>
<div class="wrap fact-strip"><div class="card facts"><div class="fact"><b>୪.୫ / ୫</b><span>ଗୁଗୁଲ୍ ମାନଚିତ୍ର ମୂଲ୍ୟାୟନ</span></div><div class="fact"><b>୨୮,୨୨୩</b><span>ସମୀକ୍ଷା ସଂଖ୍ୟା</span></div><div class="fact"><b>୬:୩୦–୧୮:୩୦</b><span>ସାଧାରଣ ଦର୍ଶନ ସମୟ</span></div><div class="fact"><b>ପ୍ରବେଶ ମୁକ୍ତ</b><span>ସାଧାରଣ ପ୍ରବେଶ</span></div><div class="fact"><b>5RRQ+XQ</b><span>ଧଉଳି, ଓଡ଼ିଶା</span></div></div></div>
<section id="about" class="section"><div class="wrap"><p class="eyebrow">ପରିଚୟ</p><h2 class="title">ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ ପରିଚୟ<span class="h2-alt">{`About ${fullName}`}</span></h2>
<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">India</a></li><li><a href="/#about">Odisha</a></li><li><a href="/#map">Bhubaneswar</a></li><li aria-current="page">Dhauli Shanti Stupa</li></ol></nav>
<p class="lead"><b>{fullName}</b> ({entity.fullNameLocal}), ଯାହାକୁ {shortName} ବା Peace Pagoda ନାମରେ ମଧ୍ୟ ଜଣାଯାଏ, {entity.cityLocal} ({city}) ସହରର ଦକ୍ଷିଣରେ ଥିବା ଧଉଳିଗିରି ପାହାଡ଼ ଉପରେ ଅବସ୍ଥିତ। {entity.stateLocal} ({state}) ରାଜ୍ୟ ଏବଂ {entity.countryLocal} ({country})ର ଏହି ଶାନ୍ତି ସ୍ତୂପ କଳିଙ୍ଗ ଯୁଦ୍ଧ ପରବର୍ତ୍ତୀ ଅହିଂସା ବାର୍ତ୍ତା ପାଇଁ ପରିଚିତ; ଏହି ଅଞ୍ଚଳ ଭ୍ରମଣ କରୁଥିବା ଯାତ୍ରୀଙ୍କ ପାଇଁ ଏହା ଏକ ପ୍ରମୁଖ କେନ୍ଦ୍ର।</p>
<p class="lead en" lang="en">Welcome to <b>{fullName}</b>, widely recognized as the central <b>{shortName}</b>. Located in <b>{city}</b>, <b>{state}</b>, <b>{country}</b>, this destination serves as a primary hub for travelers visiting the region.</p>
<div class="about-facts"><div class="card about-fact"><b>ଠିକଣା / Address</b><span>{`${entity.streetAddress}, ${state} ${entity.postalCode}, ${country}`}</span></div><div class="card about-fact"><b>ପ୍ଲସ୍ କୋଡ୍ / Plus Code</b><span>{`${entity.plusCode} Dhauli, ${state}`}</span></div><div class="card about-fact"><b>ପ୍ରକାର / Type</b><span>Peace Pagoda · Buddhist stupa (ଶାନ୍ତି ସ୍ତୂପ)</span></div><div class="card about-fact"><b>ସ୍ଥାନାଙ୍କ / Coordinates</b><span>{`${entity.latitude}° N, ${entity.longitude}° E`}</span></div><div class="card about-fact"><b>Google Maps</b><span><a href={entity.mapsUrl} target="_blank" rel="noopener noreferrer">Open Dhauli Shanti Stupa location</a></span></div></div>
</div></section>
<section id="history" class="section"><div class="wrap story-grid"><figure class="dome-panel"><img src="/images/dhauli-front.jpg" width="1280" height="855" alt={`${fullName} - staircase and white dome on Dhauligiri hill, ${city}`} loading="lazy"/><figcaption class="caption">ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ · ପାହାଡ଼ ଶୀର୍ଷର ଶାନ୍ତି ସ୍ମାରକ</figcaption></figure><div><p class="eyebrow">ଯୁଦ୍ଧରୁ ଶାନ୍ତି</p><h2 class="title">କଳିଙ୍ଗର ସ୍ମୃତି, ଶାନ୍ତିର ସନ୍ଦେଶ<span class="h2-alt">{`History & Significance of ${fullName}`}</span></h2><p class="lead">ଓଡ଼ିଶା ପର୍ଯ୍ୟଟନ ଅନୁସାରେ ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ ୧୯୭୨ ମସିହାରେ ଜାପାନ ବୁଦ୍ଧ ସଂଘ ଓ କଳିଙ୍ଗ ନିପ୍ପନ୍ ବୁଦ୍ଧ ସଂଘର ସହଯୋଗରେ ନିର୍ମିତ। ଏହା କଳିଙ୍ଗ ଯୁଦ୍ଧ ପରବର୍ତ୍ତୀ ଅହିଂସା ଓ ଶାନ୍ତିର ଐତିହାସିକ ସନ୍ଦେଶକୁ ସ୍ମରଣ କରାଏ।</p><div class="timeline"><div class="time-item"><strong>୨୬୧ ଖ୍ରୀ.ପୂ.</strong><p>କଳିଙ୍ଗ ଯୁଦ୍ଧ ସହ ଧଉଳି ଅଞ୍ଚଳର ଐତିହାସିକ ସମ୍ପର୍କ; ଅଶୋକଙ୍କ ଶାସନ ଦୃଷ୍ଟିଭଙ୍ଗୀର ଗଭୀର ପରିବର୍ତ୍ତନ ସହ ଏହି ସ୍ଥାନକୁ ଯୋଡ଼ାଯାଏ।</p></div><div class="time-item"><strong>ଶିଳାଲେଖ</strong><p>ଧଉଳିର ଅଶୋକ ଶିଳାଲେଖ ଶାସନ, ଲୋକକଲ୍ୟାଣ ଓ ନୈତିକ ଦାୟିତ୍ୱ ବିଷୟରେ ଆଦେଶ ରଖିଛି; ନିକଟରେ ଶିଳାକଟା ହାତୀ ମଧ୍ୟ ରହିଛି।</p></div><div class="time-item"><strong>୧୯୭୨</strong><p>ଆଧୁନିକ ଶାନ୍ତି ସ୍ତୂପ ନିର୍ମାଣ—ଧଳା ଗୁମ୍ବଜ, ଛତ୍ର, ସିଂହ ମୂର୍ତ୍ତି ଏବଂ ବୁଦ୍ଧ ଜୀବନ ଓ ଅଶୋକଙ୍କ ପରିବର୍ତ୍ତନକୁ ଉପସ୍ଥାପନ କରୁଥିବା ରିଲିଫ୍ ପ୍ୟାନେଲ୍ ସହ।</p></div></div></div></div></section>
<section id="visit" class="section"><div class="wrap"><p class="eyebrow">ଯିବା ପୂର୍ବରୁ</p><h2 class="title">ଭ୍ରମଣର ମୁଖ୍ୟ ସୂଚନା<span class="h2-alt">{`Location & How to Visit ${shortName} in ${city}`}</span></h2><div class="visit-grid"><article class="card visit-card"><span class="num">୦୧</span><h3>ଟିକେଟ୍ / ଖର୍ଚ୍ଚ</h3><p>ସାଧାରଣ ପ୍ରବେଶ ପାଇଁ ଶୁଳ୍କ ନାହିଁ ବୋଲି ରାଜ୍ୟ ପର୍ଯ୍ୟଟନ ସୂଚନା ଦର୍ଶାଏ। ପାର୍କିଂ କିମ୍ବା ବିଶେଷ କାର୍ଯ୍ୟକ୍ରମର ଖର୍ଚ୍ଚ ପରିବର୍ତ୍ତନଶୀଳ।</p></article><article class="card visit-card"><span class="num">୦୨</span><h3>ପାର୍କିଂ</h3><p>ପାହାଡ଼ ଶୀର୍ଷକୁ ଯାଉଥିବା ରାସ୍ତା ପାଖରେ ଯାନ ରଖିବା ବ୍ୟବସ୍ଥା ମିଳେ। ଭିଡ଼ ଦିନରେ ସକାଳେ ପହଞ୍ଚିବା ଭଲ।</p></article><article class="card visit-card"><span class="num">୦୩</span><h3>ସର୍ବୋତ୍ତମ ସମୟ</h3><p>ଅକ୍ଟୋବର–ମାର୍ଚ୍ଚ ଆରାମଦାୟକ ଋତୁ। ବର୍ଷର ଅନ୍ୟ ସମୟରେ ସକାଳ ବା ସୂର୍ଯ୍ୟାସ୍ତ ପୂର୍ବର ହାଲୁକା ସମୟ ବାଛନ୍ତୁ।</p></article><article class="card visit-card"><span class="num">୦୪</span><h3>କେତେ ସମୟ?</h3><p>୧–୨ ଘଣ୍ଟା ରଖିଲେ ସ୍ତୂପ, ଦୃଶ୍ୟବିନ୍ଦୁ ଓ ନିକଟସ୍ଥ ଐତିହାସିକ ଅଂଶ ଶାନ୍ତିରେ ଦେଖିପାରିବେ।</p></article></div></div></section>
<section class="section"><div class="wrap"><p class="eyebrow">ଦୃଶ୍ୟ ଓ ପ୍ରତୀକ</p><h2 class="title">ଧଳା ଗୁମ୍ବଜ, ବୁଦ୍ଧ ମୂର୍ତ୍ତି, ଦୟା ଉପତ୍ୟକା<span class="h2-alt">{`Architecture & Views of ${fullName}`}</span></h2><div class="gallery"><figure><img src="/images/dhauli-detail.jpg" width="1280" height="855" alt={`${fullName} - white dome and lion motif detail in ${city}, ${country}`} loading="lazy"/><figcaption>ଶାନ୍ତି ସ୍ତୂପର ସ୍ଥାପତ୍ୟ ଓ ସିଂହ ଅଳଙ୍କାର</figcaption></figure><figure><img src="/images/dhauli-buddha.jpg" width="960" height="1280" alt={`${fullName} - Buddha statue on the stupa terrace`} loading="lazy"/><figcaption>ସ୍ତୂପ ପରିକ୍ରମାରେ ବୁଦ୍ଧ ଜୀବନର ପ୍ରତୀକାତ୍ମକ ରୂପ</figcaption></figure><figure><img src="/images/dhauli-view.jpg" width="1280" height="855" alt={`${fullName} - view over the Daya river valley near ${city}`} loading="lazy"/><figcaption>ଧଉଳି ପାହାଡ଼ରୁ ସମତଳ ଭୂମି ଓ ଦୟା ନଦୀ ଦିଗ</figcaption></figure></div></div></section>
<section id="transport" class="section"><div class="wrap"><p class="eyebrow">ବିସ୍ତୃତ ଯାତାୟାତ</p><h2 class="title">ଭୁବନେଶ୍ୱରରୁ ଧଉଳି ପହଞ୍ଚିବା<span class="h2-alt">{`Getting to ${shortName} from ${city}`}</span></h2><div class="transport-grid"><article class="card route"><h3>ବିମାନ ଓ ରେଳରୁ</h3><ul><li>ନିକଟତମ ବିମାନବନ୍ଦର: ବିଜୁ ପଟ୍ଟନାୟକ ଆନ୍ତର୍ଜାତୀୟ ବିମାନବନ୍ଦର, ଭୁବନେଶ୍ୱର।</li><li>ନିକଟତମ ପ୍ରମୁଖ ରେଳଷ୍ଟେସନ୍: ଭୁବନେଶ୍ୱର।</li><li>ଦୁଇ ସ୍ଥାନରୁ ଟ୍ୟାକ୍ସି/ଆପ୍ କ୍ୟାବ୍/ଅଟୋ ନେଇ ପୁରୀ ରୋଡ୍ ଦିଗରେ ଧଉଳି ଯାଇପାରିବେ।</li></ul></article><article class="card route"><h3>ସଡ଼କ ମାର୍ଗରେ</h3><ul><li>ଭୁବନେଶ୍ୱର ସହରରୁ ପୁରୀ ରୋଡ୍ ମାର୍ଗ ସର୍ବାଧିକ ସରଳ ରୁଟ୍।</li><li>ସହରରୁ ଧଉଳି ପ୍ରାୟ ୮ କିମି ଦକ୍ଷିଣରେ; ଯାତ୍ରା ସମୟ ଟ୍ରାଫିକ୍ ଉପରେ ନିର୍ଭର କରେ।</li><li>ଶେଷ ଉପରମୁଖୀ ରାସ୍ତାରେ ପଦଚାରୀ ଓ ଯାନ ଭିଡ଼ ଥାଇପାରେ—ଧୀରେ ଚାଲନ୍ତୁ ଏବଂ ସ୍ଥାନୀୟ ନିର୍ଦ୍ଦେଶ ମାନନ୍ତୁ।</li></ul></article></div></div></section>
<section id="map" class="section"><div class="wrap"><p class="eyebrow">ସ୍ଥାନ</p><h2 class="title">ଗୁଗୁଲ୍ ମାନଚିତ୍ର<span class="h2-alt">{`${fullName} Location Map & Directions`}</span></h2><p class="lead">ଠିକଣା: {`${entity.streetAddress}, ${state} ${entity.postalCode}, ${country}`} · ପ୍ଲସ୍ କୋଡ୍ {entity.plusCode} · {`${entity.latitude}° N, ${entity.longitude}° E`}</p><div class="map-wrap"><iframe src={entity.mapsEmbedSrc} allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title={`${fullName} location map, ${city}, ${state}`}></iframe></div>
<p class="authority">For official updates and regional tourism information, visit <a href={entity.sources[0].url} target="_blank" rel="noopener noreferrer">{entity.sources[0].label}</a>. ସରକାରୀ ଓ ଅଦ୍ୟତନ ସୂଚନା ପାଇଁ <a href={entity.sources[1].url} target="_blank" rel="noopener noreferrer">ଭାରତ ପର୍ଯ୍ୟଟନ ମନ୍ତ୍ରଣାଳୟ</a> ଦେଖନ୍ତୁ। <a href={entity.mapsUrl} target="_blank" rel="noopener noreferrer">{`Open ${fullName} in Google Maps`}</a></p>
</div></section>
<section id="nearby" class="section"><div class="wrap"><p class="eyebrow">ନିକଟସ୍ଥ ଦର୍ଶନୀୟ ସ୍ଥାନ</p><h2 class="title">ଧଉଳି ସହ ଏକେ ଦିନରେ<span class="h2-alt">{`Landmarks & Attractions Around ${shortName}`}</span></h2>
<p class="lead">When visiting <b>{fullName}</b>, visitors can easily explore surrounding historical landmarks and points of interest, including <b>{entity.nearbyLandmarks[0]}</b> and <b>{entity.nearbyLandmarks[1]}</b>. {entity.fullNameLocal} ଭ୍ରମଣ ସମୟରେ ନିକଟସ୍ଥ ଅଶୋକ ଶିଳାଲେଖ, ଶିଳାକଟା ହାତୀ ଏବଂ ଲିଙ୍ଗରାଜ ମନ୍ଦିର ଅଞ୍ଚଳ ସହଜରେ ଦେଖିହେବ।</p>
<div class="nearby"><article class="card place"><div class="distance">ନିକଟେ</div><div><h3>ଅଶୋକ ଶିଳାଲେଖ ଓ ଶିଳାକଟା ହାତୀ</h3><p>ଧଉଳିର ମୁଖ୍ୟ ଐତିହାସିକ ପରିଚୟ; ଅଶୋକଙ୍କ ଶାସନ ଆଦର୍ଶ ଓ ବୌଦ୍ଧ ସମ୍ପର୍କକୁ ବୁଝିବା ପାଇଁ ଅବଶ୍ୟ ଦେଖନ୍ତୁ।</p></div></article><article class="card place"><div class="distance">୧୦ କିମି</div><div><h3>ଲିଙ୍ଗରାଜ ମନ୍ଦିର ଅଞ୍ଚଳ</h3><p>ପୁରୁଣା ଭୁବନେଶ୍ୱରର କଳିଙ୍ଗ ସ୍ଥାପତ୍ୟ ଐତିହ୍ୟର ପ୍ରମୁଖ କେନ୍ଦ୍ର। ପ୍ରବେଶ ନିୟମ ଧର୍ମୀୟ ହୋଇପାରେ—ପୂର୍ବରୁ ଯାଞ୍ଚ କରନ୍ତୁ।</p></div></article><article class="card place"><div class="distance">୧୧ କିମି</div><div><h3>ରାଜାରାଣୀ ମନ୍ଦିର</h3><p>ସୁକ୍ଷ୍ମ ଶିଳ୍ପକାର୍ଯ୍ୟ ଓ ଶାନ୍ତ ପରିବେଶ ସହିତ ଭୁବନେଶ୍ୱରର ଏକ ପରିଚିତ ଐତିହ୍ୟ ସ୍ଥାନ।</p></div></article><article class="card place"><div class="distance">୧୫ କିମି</div><div><h3>ପିପିଲି</h3><p>ଓଡ଼ିଶାର ଆପ୍ଲିକେ କାରୁକାର୍ଯ୍ୟ ପରମ୍ପରା ପାଇଁ ପରିଚିତ; ପୁରୀ ମାର୍ଗରେ ଧଉଳି ପରେ ଯୋଡ଼ିବା ସହଜ।</p></div></article></div></div></section>
<section class="section"><div class="wrap food-band"><div><p class="eyebrow" style="color:#f0c671">ନିକଟର ଖାଦ୍ୟ</p><h2 class="title">ଧଉଳି ସ୍କ୍ୱାର୍ ଓ ପୁରୀ ରୋଡ୍‌ରେ ସ୍ଥାନୀୟ ସ୍ୱାଦ</h2><p>ଏହା କୌଣସି ବ୍ୟବସାୟିକ ସୁପାରିଶ ନୁହେଁ। ଧଉଳି ତଳଭାଗ ଓ ପୁରୀ ରୋଡ୍‌ରେ ଛୋଟ ଖାଦ୍ୟ ଦୋକାନ, ଚା, ଶୀତଳ ପାନୀୟ ଓ ଓଡ଼ିଆ ଭୋଜନ ମିଳିପାରେ। ସ୍ୱଚ୍ଛତା, ତାଜାପନ ଓ ଦର ସ୍ଥାନରେ ଯାଞ୍ଚ କରନ୍ତୁ।</p></div><div class="food-tags"><span>ଦହିବରା ଆଳୁଦମ</span><span>ଡାଲମା</span><span>ପଖାଳ</span><span>ଛେନାପୋଡ଼</span><span>ଚା</span><span>ନଡ଼ିଆ ପାଣି</span></div></div></section>
<section id="faq" class="section"><div class="wrap"><p class="eyebrow">ସାଧାରଣ ପ୍ରଶ୍ନ</p><h2 class="title">ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ ପ୍ରଶ୍ନୋତ୍ତର<span class="h2-alt">{`${fullName} FAQ`}</span></h2><div class="faq">{faqs.map(([q,a])=><details class="card"><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
<section id="sources" class="section"><div class="wrap"><p class="eyebrow">ତଥ୍ୟ ଯାଞ୍ଚ ପାଇଁ</p><h2 class="title">ଅଧିକୃତ ଓ ସାର୍ବଜନୀନ ସୂତ୍ର<span class="h2-alt">{`Sources & Official References for ${fullName}`}</span></h2><p class="lead">ଯାତ୍ରା ପୂର୍ବରୁ ସମୟ, କାର୍ଯ୍ୟକ୍ରମ ଓ ପ୍ରବେଶ ବ୍ୟବସ୍ଥାର ତାଜା ସୂଚନା ଅଧିକୃତ ଚ୍ୟାନେଲରୁ ନିଶ୍ଚିତ କରନ୍ତୁ।</p><div class="sources"><a class="source-link" href="https://odishatourism.gov.in/content/tourism/en/discover/attractions/buddhist-sites/dhauligiri.html" rel="noopener noreferrer">ଓଡ଼ିଶା ପର୍ଯ୍ୟଟନ · ଧଉଳିଗିରି</a><a class="source-link" href="https://www.incredibleindia.gov.in/en/odisha/bhubaneswar/dhauligiri-hills" rel="noopener noreferrer">ଭାରତ ପର୍ଯ୍ୟଟନ · ଧଉଳିଗିରି ପାହାଡ଼</a><a class="source-link" href="https://www.bmc.gov.in/" rel="noopener noreferrer">ଭୁବନେଶ୍ୱର ମହାନଗର ନିଗମ</a><a class="source-link" href="https://maps.app.goo.gl/7qV2Q1HFgcDgmCJj7" rel="noopener noreferrer">ଗୁଗୁଲ୍ ମାନଚିତ୍ର ସ୍ଥାନ</a><a class="source-link" href="https://asi.nic.in/" target="_blank" rel="noopener noreferrer">ଭାରତୀୟ ପ୍ରତ୍ନତାତ୍ତ୍ୱିକ ସର୍ବେକ୍ଷଣ (ASI)</a></div>
<p class="updated">ତଥ୍ୟ ଶେଷ ସମୀକ୍ଷା: ୧ ସେପ୍ଟେମ୍ବର ୨୦୨୬ · Content last reviewed: September 1, 2026</p>
<p class="credit-note">ଏହି ପୃଷ୍ଠାରେ ଥିବା ସମୟ, ପ୍ରବେଶ ଓ ସ୍ଥାନ ସୂଚନା ଉପରୋକ୍ତ ସରକାରୀ/ସାର୍ବଜନୀନ ସୂତ୍ର ଅନୁସାରେ ସଂଗୃହୀତ। ଛବି କ୍ରେଡିଟ୍: ୱେବସାଇଟ୍‌ରେ ବ୍ୟବହୃତ ଫଟୋର ଅଧିକାର ସମ୍ପୃକ୍ତ ଫଟୋଗ୍ରାଫର୍/ଲାଇସେନ୍ସଧାରୀଙ୍କ ନିକଟରେ ରହିଛି (ବିସ୍ତୃତ ତାଲିକା: PHOTO-SOURCES.md)।</p>
