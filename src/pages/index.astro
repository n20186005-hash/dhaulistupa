---
import BaseLayout from '../layouts/BaseLayout.astro';
import { entity } from '../config';
import Stories from '../components/Stories.astro';
import PhotoSpots from '../components/PhotoSpots.astro';
import Facilities from '../components/Facilities.astro';
import Accessibility from '../components/Accessibility.astro';
import Etiquette from '../components/Etiquette.astro';
import WeatherSection from '../components/WeatherSection.astro';
import SeasonalStrategy from '../components/SeasonalStrategy.astro';
import Itineraries from '../components/Itineraries.astro';
import ScienceResponsibility from '../components/ScienceResponsibility.astro';
const BASE=Astro.site?.toString().replace(/\/$/,'');
const abs=(p:string)=>BASE?new URL(p,`${BASE}/`).toString():undefined;
const pageUrl=BASE?`${BASE}/`:undefined;
const {fullName,shortName,city,state,country}=entity;
const title=`${fullName}, ${city} — Timings, Entry Fee & Visitor Guide · ${entity.fullNameLocal}`;
const description=`Plan your visit to ${fullName} (${entity.fullNameLocal}) in ${entity.cityLocal}, ${entity.stateLocal}: opening hours, free entry (no entry fee), light & sound show, Ashoka rock edicts, Kalinga War history, and how to reach from ${entity.city} or Puri. ଦର୍ଶନ ସମୟ, ପ୍ରବେଶ ଶୁଳ୍କ, ଯାତାୟାତ ଓ ଇତିହାସ — ଏକ ସମ୍ପୂର୍ଣ୍ଣ ଭ୍ରମଣ ଗାଇଡ୍।`;
const images:string[]=['/images/dhauli-hero.jpg','/images/dhauli-front.jpg','/images/dhauli-detail.jpg','/images/dhauli-buddha.jpg','/images/dhauli-view.jpg'].map((p)=>abs(p)).filter((u):u is string=>!!u);
const attraction={
 '@context':'https://schema.org','@type':['TouristAttraction','LandmarksOrHistoricalBuildings'],
 ...(BASE?{'@id':`${BASE}/#attraction`}:{}),
 name:fullName,
 alternateName:[entity.fullNameLocal,'ଧଉଳିଗିରି ଶାନ୍ତି ସ୍ତୂପ','ପିସ୍ ପାଗୋଡା',shortName,`${city} ${fullName}`,...entity.alsoKnownAs],
 description:`Comprehensive visitor guide to ${fullName}, the peace pagoda of ${city}, ${state}, ${country}.`,
 ...(pageUrl?{url:pageUrl}:{}),
 ...(images.length?{image:images}:{}),
 address:{'@type':'PostalAddress',streetAddress:entity.streetAddress,addressLocality:city,addressRegion:state,postalCode:entity.postalCode,addressCountry:entity.countryCode},
 geo:{'@type':'GeoCoordinates',latitude:entity.latitude,longitude:entity.longitude},
 hasMap:entity.mapsUrl,
 containedInPlace:{'@type':'City',name:city,containedInPlace:{'@type':'AdministrativeArea',name:state,containedInPlace:{'@type':'Country',name:country}}},
 aggregateRating:{'@type':'AggregateRating',ratingValue:entity.ratingValue,reviewCount:entity.reviewCount,bestRating:5,worstRating:1},
 openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:entity.hours.opens,closes:entity.hours.closes}],
 isAccessibleForFree:true,
 sameAs:[entity.mapsUrl,...entity.sources.map((s)=>s.url)]
};
const breadcrumb=BASE?{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
 {'@type':'ListItem',position:1,name:country,item:`${BASE}/`},
 {'@type':'ListItem',position:2,name:state,item:`${BASE}/#about`},
 {'@type':'ListItem',position:3,name:city,item:`${BASE}/#map`},
 {'@type':'ListItem',position:4,name:fullName}
]}:undefined;
const faqs=[
 [`${fullName} କେଉଁଠାରେ ଅବସ୍ଥିତ? Where is ${fullName} located?`,`${fullName} (${entity.fullNameLocal}) ପୁରୀ ରୋଡ୍, ଧଉଳି, ${entity.cityLocal}, ${entity.stateLocal} ${entity.postalCode}, ${entity.countryLocal} (Plus Code ${entity.plusCode})ରେ ଅବସ୍ଥିତ। ${fullName} is located in ${city}, ${state}, ${country}.`],
 [`${fullName} ଦର୍ଶନ ମାଗଣା କି? Is ${shortName} free to visit?`,`ହଁ। ${fullName} ଏକ ସାର୍ବଜନୀନ ସ୍ମାରକ ସ୍ଥଳ; ସାଧାରଣ ପ୍ରବେଶ ବର୍ଷସାରା ମାଗଣା। Yes, ${fullName} is a public space and is free to visit year-round.`],
 ['ଧଉଳି ଶାନ୍ତି ସ୍ତୂପରେ ପ୍ରବେଶ ଶୁଳ୍କ ଅଛି କି?','ସ୍ତୂପ ପ୍ରାଙ୍ଗଣକୁ ସାଧାରଣ ପ୍ରବେଶ ପାଇଁ ସାଧାରଣତଃ ଟିକେଟ୍ ଲାଗେ ନାହିଁ। ଯାନ ପାର୍କିଂ କିମ୍ବା ବିଶେଷ କାର୍ଯ୍ୟକ୍ରମର ଶୁଳ୍କ ଅଲଗା ହୋଇପାରେ।'],
 ['କେତେ ସମୟ ରଖିବା ଭଲ?','ସ୍ତୂପ, ଦୃଶ୍ୟ, ଶିଳାଲେଖ ଅଞ୍ଚଳ ଏବଂ ଶାନ୍ତ ଭ୍ରମଣ ପାଇଁ ୧–୨ ଘଣ୍ଟା ରଖିବା ସୁବିଧାଜନକ।'],
 ['ସର୍ବୋତ୍ତମ ଭ୍ରମଣ ସମୟ କେବେ?','ଅକ୍ଟୋବରରୁ ମାର୍ଚ୍ଚ ମଧ୍ୟରେ ତାପମାତ୍ରା ତୁଳନାମୂଳକ ଆରାମଦାୟକ। ଗ୍ରୀଷ୍ମରେ ସକାଳ ବା ସନ୍ଧ୍ୟା ପୂର୍ବର ସମୟ ବାଛନ୍ତୁ।'],
 ['ଭୁବନେଶ୍ୱରରୁ କିପରି ଯିବେ?','ପୁରୀ ରୋଡ୍ ଦିଗରେ ଟ୍ୟାକ୍ସି, ଆପ୍ କ୍ୟାବ୍, ଅଟୋ ବା ନିଜସ୍ୱ ଯାନରେ ଯିବା ସହଜ। ସହର କେନ୍ଦ୍ରରୁ ଧଉଳି ପ୍ରାୟ ୮ କିମି ଦକ୍ଷିଣରେ।'],
 ['ଏଠାରେ ପାର୍କିଂ ମିଳେ କି?','ପାହାଡ଼ ଉପରକୁ ଯିବା ରାସ୍ତାର ନିକଟରେ ନିର୍ଦ୍ଦିଷ୍ଟ ଯାନ ରଖିବା ସୁବିଧା ମିଳେ। ଛୁଟି ଦିନ ଓ ପର୍ବରେ ସ୍ଥାନ ସୀମିତ ହୋଇପାରେ; ସ୍ଥାନୀୟ ସଙ୍କେତ ଅନୁସରଣ କରନ୍ତୁ।'],
 ['ଅଶୋକଙ୍କ ଶିଳାଲେଖ କେଉଁଠାରେ?','ଧଉଳି ପାହାଡ଼ ଅଞ୍ଚଳରେ ଅଶୋକଙ୍କ ପ୍ରମୁଖ ଶିଳାଲେଖ ଏବଂ ଶିଳାକଟା ହାତୀ ରହିଛି। ସ୍ତୂପ ଭ୍ରମଣ ସହ ଏହାକୁ ଏକେ ଐତିହାସିକ ପରିଦୃଶ୍ୟର ଅଂଶ ଭାବେ ଦେଖନ୍ତୁ।'],
['ଶିଳାଲେଖ ଓ ସ୍ତୂପ ଏକା ପାହାଡ଼ରେ କି?','ଧଉଳିଗିରି ଏକାଧିକ ପଥର ଶ୍ରେଣୀରେ ଗଠିତ। ଅଶୋକଙ୍କ ଶିଳାଲେଖ ଓ ପଥର ହାତୀ ଦକ୍ଷିଣ ଶ୍ରେଣୀରେ (ଅଶ୍ୱତ୍ଥାମା) ରହିଛି, ଏବଂ ଶାନ୍ତି ସ୍ତୂପ ପ୍ରମୁଖ ଶ୍ରେଣୀର ଶୀର୍ଷରେ ଅବସ୍ଥିତ—ଉଭୟଙ୍କୁ ଏକା ଭ୍ରମଣରେ ଦେଖିହୁଏ।'],
['ଧଉଳିରେ ଶୌଚାଳୟ, ପାନୀୟ ଜଳ ଓ ବିଶ୍ରାମ ସ୍ଥାନ ମିଳେ କି?','ସ୍ତୂପ ତଳଭାଗ ଓ ଯାନ ରଖିବା ଅଞ୍ଚଳରେ ସାଧାରଣ ଶୌଚାଳୟ, ଛାଇ/ବିଶ୍ରାମ ସ୍ଥାନ ଏବଂ ଛୋଟ ଦୋକାନରେ ପାନୀୟ ଜଳ ମିଳିଥାଏ। ଏହା ଏକ ଅଲାଭକାରୀ ଗାଇଡ୍ ହୋଇଥିବାରୁ ଆମେ କୌଣସି ନିର୍ଦ୍ଦିଷ୍ଟ ଦୋକାନର ନାମ ଦେଉନାହୁଁ; ସୁବିଧାର ସ୍ତର ଦିନ ଓ ଭିଡ଼ ଅନୁସାରେ ବଦଳିପାରେ, ତେଣୁ ନିଜ ପାଣି ବୋତଲ ସାଥରେ ରଖିବା ଭଲ।'],
['ଉପରକୁ ଯିବାକୁ କେତେ ସିଢ଼ି? ବୟସ୍କ ଓ ଶିଶୁଙ୍କ ପାଇଁ କଷ୍ଟକର କି?','ଯାନ ରଖିବା ସ୍ଥାନରୁ ସ୍ତୂପ ପର୍ଯ୍ୟନ୍ତ ଏକ ସିଢ଼ିଯୁକ୍ତ ଚଢ଼ାଇ ରହିଛି; ସଂଖ୍ୟା ଓ ମାର୍ଗ ସ୍ଥାନୀୟ ବ୍ୟବସ୍ଥା ଅନୁସାରେ ବଦଳିପାରେ। ବୟସ୍କ ଓ ଶିଶୁଙ୍କ ସହିତ ହେଲେ ଧୀରେ ଚାଲନ୍ତୁ ଏବଂ ମଝିରେ ବିଶ୍ରାମ ନିଅନ୍ତୁ। ହ୍ୱିଲ୍‌ଚେୟାର୍ ପାଇଁ ରାମ୍ପ୍ ସୁବିଧା ସୀମିତ—ପୂର୍ବରୁ ସ୍ଥାନୀୟ ସୂଚନା ନିଅନ୍ତୁ।'],
['ଫଟୋ ଉଠାଇବା ଓ ଡ୍ରୋନ୍ ଉଡ଼ାଇବା ଅନୁମତ କି?','ବ୍ୟକ୍ତିଗତ ଫଟୋଗ୍ରାଫି ସାଧାରଣତଃ ଅନୁମତ। ବିନା ଲିଖିତ ଅନୁମତିରେ ଡ୍ରୋନ୍ ଉଡ଼ାନ୍ତୁ ନାହିଁ କିମ୍ବା ବ୍ୟବସାୟିକ ଶୁଟିଂ କରନ୍ତୁ ନାହିଁ; ସଂରକ୍ଷିତ ଶିଳାଲେଖ ଅଞ୍ଚଳରେ ନିୟମ ଅଧିକ କଡ଼ାକଡ଼ି ହୋଇପାରେ।'],
['ସନ୍ଧ୍ୟାରେ ଆଲୋକ-ଧ୍ୱନି କାର୍ଯ୍ୟକ୍ରମ (light & sound show) ଅଛି କି? Is there a light & sound show at Dhauli?','କେତେକ ସମୟରେ ସନ୍ଧ୍ୟାରେ ସ୍ତୂପ ଆଲୋକିତ ହୋଇ କଳିଙ୍ଗ କାହାଣୀ ଉପରେ ଆଧାରିତ ଧ୍ୱନି-ଆଲୋକ କାର୍ଯ୍ୟକ୍ରମ ହୁଏ। ଏହାର ସମୟ, ଦିନ ଓ ଟିକେଟ୍ ବ୍ୟବସ୍ଥା ଋତୁ ଏବଂ ପ୍ରଶାସନିକ ନିଷ୍ପତ୍ତି ଅନୁସାରେ ବଦଳେ—ଯାତ୍ରା ପୂର୍ବରୁ ସ୍ଥାନୀୟ ଘୋଷଣା ବା ଅଧିକୃତ ସୂତ୍ରରୁ ନିଶ୍ଚିତ କରନ୍ତୁ।'],
['ବର୍ଷା ଦିନରେ ଯିବା ଠିକ୍ କି?','ମୌସୁମୀରେ ପାହାଡ଼ର ଦୃଶ୍ୟ ସବୁଜ ରହେ ଓ ଭିଡ଼ କମ୍ ଥାଏ, କିନ୍ତୁ ପ୍ରସ୍ତର ସିଢ଼ି ଖସଡ଼ା ହୋଇଯାଏ। ଅଣ-ସ୍ଲିପ୍ ଜୋତା ପିନ୍ଧନ୍ତୁ, ଏବଂ ବଜ୍ରପାତ ସମୟରେ ଖୋଲା ଛାତ ଉପରେ ଠିଆ ହୁଅନ୍ତୁ ନାହିଁ।']
,['Dhauli Shanti Stupa ଦର୍ଶନ ସମୟ କଣ? What are the Dhauli Shanti Stupa opening hours / timings?',`ସାଧାରଣ ଦର୍ଶନ ସମୟ ପ୍ରାୟ ସକାଳ ୬:୩୦ରୁ ସନ୍ଧ୍ୟା ୬:୩୦ ପର୍ଯ୍ୟନ୍ତ (ଋତୁ ଅନୁସାରେ ବଦଳିପାରେ)। The stupa is generally open ~06:30–18:30; hours may vary by season, so confirm with local notices before visiting.`]
,['Dhauli Shanti Stupa ପ୍ରବେଶ ଶୁଳ୍କ ଅଛି କି? Is there an entry fee for Dhauli Shanti Stupa?',`ସାଧାରଣ ପ୍ରବେଶ ମାଗଣା—କୌଣସି entry fee ନାହିଁ; ରାଜ୍ୟ ପର୍ଯ୍ୟଟନ ଅନୁସାରେ ସାଧାରଣ ଦର୍ଶନ ପାଇଁ ଟିକେଟ୍ ଲାଗେ ନାହିଁ। General entry is free (no entry fee); parking or special events may cost extra.`]
,['Bhubaneswar ରୁ Dhauli କେତେ ଦୂର? Puri ରୁ କିପରି ଯିବେ? How far is Dhauli from Bhubaneswar, and how to reach from Puri?',`ଭୁବନେଶ୍ୱର ସହର କେନ୍ଦ୍ରରୁ ଧଉଳି ପ୍ରାୟ ୮ କିମି ଦକ୍ଷିଣରେ; ପୁରୀ ସହରରୁ ପ୍ରାୟ ୬୦ କିମି (୧.୫–୨ ଘଣ୍ଟା) NH-316 (ପୁରୀ ରୋଡ଼) ଦ୍ୱାରା। Dhauli is ~8 km south of central Bhubaneswar and ~60 km (1.5–2 hrs) from Puri via NH-316 (Puri Road).`]
,['Dhauli Shanti Stupa ଓ କଳିଙ୍ଗ ଯୁଦ୍ଧର ସମ୍ପର୍କ କଣ? What is the history of Dhauli Shanti Stupa and the Kalinga War?',`ଧଉଳିଗିରି କଳିଙ୍ଗ ଯୁଦ୍ଧର ଭୂଗୋଳ ସହ ସମ୍ପୃକ୍ତ—ଏଠାରୁ ଅଶୋକ ଯୁଦ୍ଧ ପରେ ଅହିଂସା ଓ ଧର୍ମର ପଥ ନେଇଥିଲେ। ଆଧୁନିକ ଶାନ୍ତି ସ୍ତୂପ ୧୯୭୨ରେ ନିର୍ମିତ। Dhauligiri is linked to the Kalinga War; after the war Emperor Ashoka embraced non-violence and Dhamma. The modern Peace Pagoda was built in 1972.`]
,['Dhauli ରେ ଅଶୋକଙ୍କ ଶିଳାଲେଖ କେଉଁଠାରେ? Where are Ashoka rock edicts at Dhauli?',`ଧଉଳି ପାହାଡ଼ରେ ଅଶୋକଙ୍କ ପ୍ରଥମରୁ ଦଶମ ଓ ଚତୁର୍ଦ୍ଦଶ ମୁଖ୍ୟ ଶିଳାଲେଖ ଏବଂ ଶିଳାକଟା ହାତୀ ରହିଛି—ସ୍ତୂପ ଭ୍ରମଣ ସହ ଏହାକୁ ଏକେ ଦେଖନ୍ତୁ। On Dhauligiri hill are Ashoka's major rock edicts (I–X, XIV) and the rock-cut elephant; see them together with the stupa.`]
];
const faqLd={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
