---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONTENT_DATE, entity } from '../config';
interface Props {title:string;description:string;path?:string;image?:string;imageAlt?:string;ogTitle?:string;jsonLd?:unknown[];noindex?:boolean;aboutAttraction?:boolean;}
const {title,description,path='/',image,imageAlt,ogTitle,jsonLd=[],noindex=false,aboutAttraction=false}=Astro.props;
const site=Astro.site?.toString().replace(/\/$/,'');
const absolute=(p:string)=>site?new URL(p,`${site}/`).toString():undefined;
const canonical=absolute(path);
const ogImage=image?absolute(image):undefined;
const ogImageAlt=imageAlt??`${entity.fullName} in ${entity.city}, ${entity.state}, ${entity.country}`;

/* Site-wide entity graph: Organization -> WebSite -> WebPage. Only emitted once a
   production domain is configured so nothing is invented while SITE is empty. */
const graph=site?{
 '@context':'https://schema.org',
 '@graph':[
  {'@type':'Organization','@id':`${site}/#organization`,
   name:`${entity.fullName} ${entity.city} Travel Guide`,
   url:`${site}/`,
   description:'Independent, non-commercial visitor information project about Dhauli Shanti Stupa.',
   logo:{'@type':'ImageObject',url:absolute('/icons/icon-512.png'),width:512,height:512}},
  {'@type':'WebSite','@id':`${site}/#website`,
   url:`${site}/`,name:`${entity.fullName} ${entity.city} Travel Guide`,
   publisher:{'@id':`${site}/#organization`},inLanguage:'or'},
  {'@type':'WebPage','@id':`${site}${path}#webpage`,
   url:canonical,isPartOf:{'@id':`${site}/#website`},
   ...(aboutAttraction?{about:{'@id':`${site}/#attraction`},primaryImageOfPage:{'@type':'ImageObject',url:ogImage}}:{}),
   name:title,description,
   datePublished:CONTENT_DATE,dateModified:CONTENT_DATE,inLanguage:'or'}
 ]}:undefined;
const pageJsonLd=graph?[graph,...jsonLd]:jsonLd;
---
<!doctype html><html lang="or"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#17211f"/>
{canonical&&<link rel="canonical" href={canonical}/>} {noindex&&<meta name="robots" content="noindex,follow"/>}
<meta property="og:type" content="website"/><meta property="og:site_name" content={`${entity.fullName} ${entity.city} Travel Guide`}/><meta property="og:locale" content="or_IN"/><meta property="og:title" content={ogTitle??title}/><meta property="og:description" content={description}/>{canonical&&<meta property="og:url" content={canonical}/>} {ogImage&&<meta property="og:image" content={ogImage}/>}{ogImage&&<meta property="og:image:alt" content={ogImageAlt}/>}<meta name="twitter:card" content="summary_large_image"/>{ogImage&&<meta name="twitter:image" content={ogImage}/>}{ogImage&&<meta name="twitter:image:alt" content={ogImageAlt}/>}
<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png"/><link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png"/><link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180"/><link rel="apple-touch-icon" href="/icons/icon-192.png" sizes="192x192"/><link rel="apple-touch-icon" href="/icons/icon-512.png" sizes="512x512"/>
<link rel="manifest" href="/manifest.webmanifest"/><meta name="application-name" content="Dhauli Stupa"/><meta name="mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/><meta name="apple-mobile-web-app-title" content="Dhauli Stupa"/>
{pageJsonLd.map((item)=><script is:inline type="application/ld+json" set:html={JSON.stringify(item)}/>)}
<script is:inline>(()=>{const id='G-HXM22WWPKP',key='dhauli-cookie-preferences';try{const p=JSON.parse(localStorage.getItem(key)||'{}');if(p.analytics!==true)return;window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};window.gtag('js',new Date());window.gtag('config',id,{anonymize_ip:true});const s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(id);document.head.appendChild(s)}catch(_){}})();</script>
<script is:inline>if('serviceWorker' in navigator){addEventListener('load',()=>{navigator.serviceWorker.register('/sw.js').catch(()=>{})})}</script>
</head><body><a class="skip" href="#content">ମୁଖ୍ୟ ବିଷୟବସ୍ତୁକୁ ଯାଆନ୍ତୁ</a><Header/><main id="content"><slot/></main><Footer/></body></html>
