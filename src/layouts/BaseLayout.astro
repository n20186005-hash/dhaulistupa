---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {title:string;description:string;path?:string;image?:string;jsonLd?:unknown[];noindex?:boolean;}
const {title,description,path='/',image,jsonLd=[],noindex=false}=Astro.props;
const site=Astro.site?.toString().replace(/\/$/,'');
const absolute=(p:string)=>site?new URL(p,`${site}/`).toString():undefined;
const canonical=absolute(path);
const ogImage=image?absolute(image):undefined;
---
<!doctype html><html lang="or"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#17211f"/>
{canonical&&<link rel="canonical" href={canonical}/>} {noindex&&<meta name="robots" content="noindex,follow"/>}
<meta property="og:type" content="website"/><meta property="og:locale" content="or_IN"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{canonical&&<meta property="og:url" content={canonical}/>} {ogImage&&<meta property="og:image" content={ogImage}/>}<meta name="twitter:card" content="summary_large_image"/>
<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png"/><link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png"/><link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180"/>
{jsonLd.map((item)=><script type="application/ld+json" set:html={JSON.stringify(item)}/>)}
<script is:inline>(()=>{const id='G-HXM22WWPKP',key='dhauli-cookie-preferences';try{const p=JSON.parse(localStorage.getItem(key)||'{}');if(p.analytics!==true)return;window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};window.gtag('js',new Date());window.gtag('config',id,{anonymize_ip:true});const s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(id);document.head.appendChild(s)}catch(_){}})();</script>
</head><body><a class="skip" href="#content">ମୁଖ୍ୟ ବିଷୟବସ୍ତୁକୁ ଯାଆନ୍ତୁ</a><Header/><main id="content"><slot/></main><Footer/></body></html>
