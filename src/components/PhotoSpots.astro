---
import { entity } from '../config';

const spots = [
  {
    t: 'ଧଳା ଗୁମ୍ବଜର ନିକଟ ଦୃଶ୍ୟ',
    d: 'ସ୍ତୂପର ଶ୍ୱେତ ଗୁମ୍ବଜ, ଛତ୍ର ଓ ପରିଧିର ରିଲିଫ୍ ପ୍ୟାନେଲ୍—ପାହାଡ଼ର ଉପର ପାହାଚରୁ ସବୁଠାରୁ ପରିଚିତ ଫ୍ରେମ୍।',
    w: 'ସୂର୍ଯ୍ୟୋଦୟ ପରେ ୧ ଘଣ୍ଟା / ସନ୍ଧ୍ୟା ପୂର୍ବରୁ',
  },
  {
    t: 'ସିଢ଼ିରୁ ଉପରମୁହାଁ ଦୃଶ୍ୟ',
    d: 'ପ୍ରସ୍ତର ସିଢ଼ିର ରେଖା ସ୍ତୂପ ଆଡ଼କୁ ଦୃଷ୍ଟି ନେଇଯାଏ; ଗଭୀରତା ଓ ମାପର ଅନୁଭବ ଦେବା ପାଇଁ ଭଲ।',
    w: 'ସକାଳର କୋଣୀୟ ଆଲୋକ',
  },
  {
    t: 'ଦୟା ନଦୀ ଉପତ୍ୟକାର ଦିଗ୍‌ବଳୟ',
    d: 'ଶୀର୍ଷରୁ ସମତଳ କ୍ଷେତ୍ର ଓ ଦୟା ନଦୀର ଦିଗ୍‌ବଳୟ—କଳିଙ୍ଗ ଯୁଦ୍ଧର ଭୂଦୃଶ୍ୟ ବୁଝିବାର ସର୍ବୋତ୍ତମ ସ୍ଥାନ।',
    w: 'ସୂର୍ଯ୍ୟାସ୍ତର ୪୫ ମିନିଟ୍ ପୂର୍ବରୁ',
  },
  {
    t: 'ପଥର ହାତୀ ଓ ଶିଳାଲେଖ ଅଞ୍ଚଳ',
    d: 'ମୌର୍ଯ୍ୟ କାଳର ଶିଳାକଟା ହାତୀ ଓ ଖୋଦିତ ଲିପି—ଛାଇ ଓ ଗାତ୍ରର ଗଠନ ଦେଖାଇବା ପାଇଁ ପାର୍ଶ୍ୱ ଆଲୋକ ଦରକାର।',
    w: 'ମଧ୍ୟାହ୍ନ ପୂର୍ବରୁ (କଠିନ ଛାଇ ଏଡ଼ାନ୍ତୁ)',
  },
  {
    t: 'ସନ୍ଧ୍ୟାର ଆଲୋକିତ ସ୍ତୂପ',
    d: 'କେତେକ ସମୟରେ ସନ୍ଧ୍ୟାରେ ସ୍ତୂପ ଆଲୋକିତ ହୁଏ ଓ କଳିଙ୍ଗ କାହାଣୀ ଉପରେ ଆଧାରିତ ଧ୍ୱନି-ଆଲୋକ କାର୍ଯ୍ୟକ୍ରମ ହୁଏ।',
    w: 'କାର୍ଯ୍ୟକ୍ରମ ସମୟ ସ୍ଥାନୀୟ ଘୋଷଣା ଉପରେ ନିର୍ଭର',
  },
];
---

<section id="photos" class="section">
  <div class="wrap">
    <p class="eyebrow">ଫଟୋଗ୍ରାଫି</p>
    <h2 class="title">କେଉଁଠି ଓ କେବେ ଫଟୋ ଉଠାଇବେ<span class="h2-alt">Photography Spots at {entity.fullName}</span></h2>
    <p class="lead">ବ୍ୟକ୍ତିଗତ ଫଟୋଗ୍ରାଫି ସାଧାରଣତଃ ଅନୁମତ; ବ୍ୟବସାୟିକ ଶୁଟିଂ ଓ ଡ୍ରୋନ୍ ପାଇଁ ଲିଖିତ ଅନୁମତି ଆବଶ୍ୟକ। ତ୍ରାଇପଡ୍ ବ୍ୟବହାର ସମୟରେ ଅନ୍ୟ ଦର୍ଶକଙ୍କ ପଥ ଅବରୋଧ କରନ୍ତୁ ନାହିଁ।</p>
    <div class="shots">
      {spots.map((s, i) => (
        <article class="card shot">
          <span class="shot-no">{`0${i + 1}`}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          <span class="hint">{s.w}</span>
        </article>
      ))}
    </div>
  </div>
</section>
