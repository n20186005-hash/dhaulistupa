---
import { entity } from '../config';

const audiences = [
  {
    icon: '👨‍👩‍👧‍👦',
    t: 'ପରିବାର (ପିଲା ସହିତ)',
    d: 'ନିମ୍ନ ଗତି, ଛାଇ ଓ ବିଶ୍ରାମ ସହିତ। ପାହାଡ଼ ପାଦର ଅଶୋକ ଶିଳାଲେଖ ଓ ପଥର ହାତୀ (ସମତଳ) ଦେଖନ୍ତୁ, ତାପରେ ଧୀରେ ସିଢ଼ି ଚଢ଼ି ସ୍ତୂପ ଉପରକୁ ଯିବା। ମଝିରେ ବିଶ୍ରାମ ଓ ପାଣି।',
    h: 'ସମୟ: ୨–୩ ଘଣ୍ଟା · ଶାନ୍ତ ଗତି',
  },
  {
    icon: '📷',
    t: 'ଫଟୋଗ୍ରାଫି ଓ ପ୍ରକୃତି',
    d: 'ସୂର୍ଯ୍ୟୋଦୟ ପରେ ଧଳା ଗୁମ୍ବଜ ଓ ଛତ୍ର, ସିଢ଼ିର ରେଖା, ଦୟା ଉପତ୍ୟକା ଦିଗ୍‌ବଳୟ ଏବଂ ସନ୍ଧ୍ୟାର ଆଲୋକିତ ସ୍ତୂପ। ପକ୍ଷୀ ଓ ମୟୂର ପାଇଁ ସକାଳ ଭଲ।',
    h: 'ସମୟ: ୩–୪ ଘଣ୍ଟା · ସୁବର୍ଣ୍ଣ ସମୟ',
  },
  {
    icon: '♿',
    t: 'ନିମ୍ନ ଶାରୀରିକ / ଅକ୍ଷମ',
    d: 'ପାହାଡ଼ ପାଦର ଶିଳାଲେଖ ଓ ହାତୀ ଅଞ୍ଚଳ (ସମତଳ, ଛାଇ) ଦେଖନ୍ତୁ; ଉପରକୁ ଢାଲୁ ସିଢ଼ି ଏଡ଼ାନ୍ତୁ। ସମ୍ଭବ ହେଲେ ଯାନକୁ ମଧ୍ୟଭାଗ ପର୍ଯ୍ୟନ୍ତ ନିଅନ୍ତୁ ଏବଂ ବସାରେ ବସି ଦୃଶ୍ୟ ଉପଭୋଗ କରନ୍ତୁ।',
    h: 'ସମୟ: ୧–୧.୫ ଘଣ୍ଟା · ସମତଳ ରୁଟ୍',
  },
];

const plans = [
  {
    t: 'ଅର୍ଦ୍ଧ-ଦିଵସ (Half-day)',
    h: '~୩–୪ ଘଣ୍ଟା',
    items: [
      'ପାହାଡ଼ ପାଦ: ଅଶୋକ ଶିଳାଲେଖ + ପଥର ହାତୀ (ସମତଳ ପରିଦୃଶ୍ୟ)',
      'ସିଢ଼ି ଚଢ଼ି ସ୍ତୂପ ଶୀର୍ଷରେ ଧଳା ଗୁମ୍ବଜ ଓ ରିଲିଫ୍ ପ୍ୟାନେଲ',
      'ଦୟା ଉପତ୍ୟକା ଦୃଶ୍ୟ + ଛାଇରେ ବିଶ୍ରାମ',
      'ଫୁଟ୍ ପାହାଡ଼ ତଳେ ଛୋଟ ଖାଦ୍ୟ/ଚା ପ୍ରକାର',
    ],
  },
  {
    t: 'ସମ୍ପୂର୍ଣ ଦିନ (Full-day)',
    h: '~୬–୭ ଘଣ୍ଟା',
    items: [
      'ସକାଳରେ ଧଉଳି ଶାନ୍ତି ସ୍ତୂପ (ଉପରୋକ୍ତ ଅର୍ଦ୍ଧ-ଦିଵସ ରୁଟ୍)',
      'ଭୁବନେଶ୍ୱର ପୁରୁଣା ସହର: ଲିଙ୍ଗରାଜ ମନ୍ଦିର ଅଞ୍ଚଳ (କଳିଙ୍ଗ ସ୍ଥାପତ୍ୟ)',
      'ରାଜାରାଣୀ ଓ ମୁକ୍ତେଶ୍ୱର ମନ୍ଦିର ପ୍ରକାର',
      'ପୁରୀ ମାର୍ଗରେ ପିପିଲି (ଓଡ଼ିଶା ଆପ୍ଲିକ୍ କାରୁକାର୍ଯ୍ୟ) ପ୍ରକାର — ଫେରି ସନ୍ଧ୍ୟାରେ',
    ],
  },
];
---

<section id="routes" class="section">
  <div class="wrap">
    <p class="eyebrow">ଯାତ୍ରୀ ଅନୁସାରେ ରୁଟ୍</p>
    <h2 class="title">ଆପଣଙ୍କ ପାଇଁ ଉପଯୁକ୍ତ ରୁଟ୍<span class="h2-alt">Itineraries by Traveller Type</span></h2>
    <p class="lead">ଯାତ୍ରୀ ଗଠନ ଓ ଗତି ଅନୁସାରେ ତିନିଟି ଲକ୍ଷ୍ୟଭିତ୍ତିକ ରୁଟ୍; ତା’ ପରେ ସାଧାରଣ ଅର୍ଦ୍ଧ-ଦିଵସ ଓ ସମ୍ପୂର୍ଣ ଦିନ ପରିକଳ୍ପନା।</p>
    <div class="aud-grid">
      {audiences.map((a) => (
        <article class="card aud-card">
          <span class="aud-ico">{a.icon}</span>
          <h3>{a.t}</h3>
          <p>{a.d}</p>
          <span class="hint">{a.h}</span>
        </article>
      ))}
    </div>
    <div class="plan-grid">
      {plans.map((p) => (
        <article class="card plan-card">
          <div class="plan-head"><h3>{p.t}</h3><span class="hint">{p.h}</span></div>
          <ol>{p.items.map((i) => <li>{i}</li>)}</ol>
        </article>
      ))}
    </div>
  </div>
</section>
