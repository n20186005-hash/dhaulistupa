---
import { entity } from '../config';

/* Visitor-service TYPES only. No merchant, brand or establishment names:
   the project is an independent non-commercial guide and stays neutral. */
const facilities = [
  {
    t: 'ଶୌଚାଳୟ / Public toilets',
    d: 'ସ୍ତୂପ ପାହାଡ଼ର ତଳଭାଗ ଓ ଯାନ ରଖିବା ଅଞ୍ଚଳରେ ସାଧାରଣ ଶୌଚାଳୟର ବ୍ୟବସ୍ଥା ରହିଥାଏ। ପରିଷ୍କାରତାର ସ୍ତର ଦିନ, ସମୟ ଓ ଭିଡ଼ ଅନୁସାରେ ବଦଳିପାରେ—ନିଜେ ଟିସୁ ଓ ହ୍ୟାଣ୍ଡ୍ ସାନିଟାଇଜର୍ ସାଥରେ ରଖିବା ସୁବିଧାଜନକ।',
    h: 'ସ୍ଥାନୀୟ ସଙ୍କେତ ଅନୁସରଣ କରନ୍ତୁ',
  },
  {
    t: 'ପାର୍କିଂ / Parking',
    d: 'ପାହାଡ଼ ଉପରକୁ ଯାଉଥିବା ରାସ୍ତା ନିକଟରେ ଦୁଇଚକିଆ ଓ ଚାରିଚକିଆ ଯାନ ପାଇଁ ନିର୍ଦ୍ଦିଷ୍ଟ ସ୍ଥାନ ମିଳେ। ଛୁଟି ଦିନ ଓ ପର୍ବରେ ସ୍ଥାନ ସୀମିତ ହୁଏ; ପାର୍କିଂ ଶୁଳ୍କ ସମୟ ଅନୁସାରେ ବଦଳିପାରେ।',
    h: 'ସକାଳେ ପହଞ୍ଚିଲେ ସୁବିଧା',
  },
  {
    t: 'ଖାଦ୍ୟ ଓ ପାନୀୟ / Food & drinks',
    d: 'ଧଉଳି ତଳଭାଗ ଓ ପୁରୀ ରୋଡ୍ କଡ଼ରେ ଛୋଟ ଖାଦ୍ୟ ଦୋକାନ, ଚା, ଜଳଖିଆ ଓ ଶୀତଳ ପାନୀୟ ମିଳିଥାଏ। ଗରମ ଋତୁରେ ପାନୀୟ ଜଳ ନିଜ ବୋତଲରେ ଆଣିବା ସୁରକ୍ଷିତ; ଖାଦ୍ୟ ବାଛିବା ବେଳେ ସ୍ୱଚ୍ଛତା ଓ ତାଜାପଣ ଦେଖନ୍ତୁ।',
    h: 'ବ୍ୟକ୍ତିଗତ ପସନ୍ଦ ଉପରେ ନିର୍ଭର',
  },
  {
    t: 'ରହଣି / Accommodation',
    d: 'ଧଉଳି ଗ୍ରାମ ଅଞ୍ଚଳରେ ରହଣିର ବିକଳ୍ପ ସୀମିତ। ଅଧିକାଂଶ ଯାତ୍ରୀ ଭୁବନେଶ୍ୱର ସହରର ହୋଟେଲ୍, ଗେଷ୍ଟ୍ ହାଉସ୍ ବା ବଜେଟ୍ ଲଜ୍‌ରୁ ଆସି ଅଧା ଦିନର ଭ୍ରମଣ କରନ୍ତି।',
    h: `${entity.city} ସହରରୁ ପ୍ରାୟ ୮ କିମି`,
  },
  {
    t: 'ଦୈନନ୍ଦିନ ସାମଗ୍ରୀ / Groceries',
    d: 'ତଳଭାଗର ଛୋଟ ଦୋକାନରେ ପାଣି, ଜଳଖିଆ, ପୂଜା ସାମଗ୍ରୀ ଓ ସାଧାରଣ ଦୈନନ୍ଦିନ ଜିନିଷ ମିଳିପାରେ। ଔଷଧ, ଇଲେକ୍ଟ୍ରୋନିକ୍ ସାମଗ୍ରୀ ବା ବଡ଼ କିଣାକିଣି ପାଇଁ ସହର ଦିଗକୁ ଯିବା ଉପଯୁକ୍ତ।',
    h: 'ସୀମିତ ଭଣ୍ଡାର',
  },
  {
    t: 'ଇନ୍ଧନ ଓ ଚାର୍ଜିଂ / Fuel & EV',
    d: 'ପୁରୀ ରୋଡ୍ (NH-316) କରିଡରରେ ଇନ୍ଧନ ପମ୍ପ୍ ଏବଂ କେତେକ ସ୍ଥାନରେ ବୈଦ୍ୟୁତିକ ଯାନ ଚାର୍ଜିଂ ପଏଣ୍ଟ୍ ମିଳେ। ଲମ୍ବା ଯାତ୍ରା ପୂର୍ବରୁ ଇନ୍ଧନ ବା ଚାର୍ଜ ସ୍ଥିତି ଯାଞ୍ଚ କରିନିଅନ୍ତୁ।',
    h: 'ମୁଖ୍ୟ ସଡ଼କ କଡ଼ରେ',
  },
  {
    t: 'ସ୍ୱାସ୍ଥ୍ୟ ଓ ଔଷଧ / Medical',
    d: 'ନିକଟରେ ଛୋଟ ଔଷଧ ଦୋକାନ ମିଳିପାରେ, କିନ୍ତୁ ନିୟମିତ ଔଷଧ ନିଜେ ଆଣିବା ଉଚିତ। ଜରୁରୀ ଚିକିତ୍ସା ପାଇଁ ଭୁବନେଶ୍ୱରର ବଡ଼ ଡାକ୍ତରଖାନା ଉପରେ ନିର୍ଭର କରନ୍ତୁ।',
    h: 'ଜରୁରୀ ସେବା: ସହରରେ',
  },
  {
    t: 'ନଗଦ ଓ ଡିଜିଟାଲ୍ ପେମେଣ୍ଟ୍ / Cash & ATM',
    d: 'ଅନେକ ଛୋଟ ଦୋକାନରେ ଡିଜିଟାଲ୍ ପେମେଣ୍ଟ୍ ଚାଲିଲେ ମଧ୍ୟ ପାର୍କିଂ, ଛୋଟ କିଣାକିଣି ଓ ଦାନ-ପାତ୍ର ପାଇଁ କିଛି ନଗଦ ଟଙ୍କା ସାଥରେ ରଖିବା ସୁବିଧାଜନକ। ATM ପାଇଁ ସହର ଦିଗକୁ ଯିବାକୁ ହୁଏ।',
    h: 'କିଛି ନଗଦ ରଖନ୍ତୁ',
  },
  {
    t: 'ପାନୀୟ ଜଳ / Drinking water',
    d: 'ପାହାଡ଼ ତଳଭାଗ ଓ ଯାନ ରଖିବା ଅଞ୍ଚଳରେ ସାଧାରଣ ପାନୀୟ ଜଳ ପାଇଣ୍ଟ୍ ମିଳିପାରେ, କିନ୍ତୁ ସୀମିତ। ଗରମ ଋତୁ ଓ ଦୀର୍ଘ ଭ୍ରମଣ ପାଇଁ ନିଜ ପାଣି ବୋତଲ୍ ଆଣିବା ଓ ରିଫିଲ୍ କରିବା ଉତ୍ତମ।',
    h: 'ନିଜ ବୋତଲ୍ ରଖନ୍ତୁ',
  },
  {
    t: 'ସୂଚନା କେନ୍ଦ୍ର / Info point',
    d: 'ପାହାଡ଼ ପାଦ ଓ ପାର୍କିଂ ନିକଟରେ ସାଧାରଣ ସୂଚନା ଫଳକ ଓ ସଙ୍କେତ ରହିଥାଏ (ଓଡ଼ିଆ/ଇଂରାଜୀ/ହିନ୍ଦୀ)। ବିସ୍ତୃତ ଯାତ୍ରା ସୂଚନା ପାଇଁ ଉପରୋକ୍ତ ସରକାରୀ ପର୍ଯ୍ୟଟନ ସୂତ୍ର ଦେଖନ୍ତୁ।',
    h: 'ସଙ୍କେତ ଅନୁସରଣ କରନ୍ତୁ',
  },
];
---

<section id="facilities" class="section">
  <div class="wrap">
    <p class="eyebrow">ଭ୍ରମଣ ସୁବିଧା</p>
    <h2 class="title">ଧଉଳିରେ ମିଳୁଥିବା ସୁବିଧା<span class="h2-alt">Facilities & Visitor Services near {entity.shortName}</span></h2>
    <p class="lead">ଏଠାରେ କେବଳ <b>ସୁବିଧାର ପ୍ରକାର</b> ବର୍ଣ୍ଣନା କରାଯାଇଛି—କୌଣସି ନିର୍ଦ୍ଦିଷ୍ଟ ଦୋକାନ, ହୋଟେଲ୍, ରେଷ୍ଟୁରାଣ୍ଟ ବା ସେବା ପ୍ରଦାନକାରୀଙ୍କ ନାମ ଦିଆଯାଇନାହିଁ। ଏହା ଏକ ଅଲାଭକାରୀ ସୂଚନା ପ୍ରକଳ୍ପ, ତେଣୁ ଆମେ କୌଣସି ବ୍ୟବସାୟକୁ ସୁପାରିଶ କରୁନାହୁଁ।</p>
    <div class="fac-grid">
      {facilities.map((f) => (
        <article class="card fac-card">
          <h3>{f.t}</h3>
          <p>{f.d}</p>
          <span class="hint">{f.h}</span>
        </article>
      ))}
    </div>
    <p class="neutral-note">ସମୟ, ଶୁଳ୍କ ଓ ଉପଲବ୍ଧତା ଋତୁ, ଦିନ ଓ ସ୍ଥାନୀୟ ପ୍ରଶାସନର ନିୟମ ଅନୁସାରେ ବଦଳିପାରେ। ଯାତ୍ରା ପୂର୍ବରୁ ସ୍ଥାନୀୟ ସଙ୍କେତ ଏବଂ <a href={entity.sources[0].url} target="_blank" rel="noopener noreferrer">ଓଡ଼ିଶା ପର୍ଯ୍ୟଟନ</a> / <a href={entity.sources[2].url} target="_blank" rel="noopener noreferrer">ଭୁବନେଶ୍ୱର ମହାନଗର ନିଗମ</a>ର ସୂଚନା ଯାଞ୍ଚ କରନ୍ତୁ।</p>
  </div>
</section>
