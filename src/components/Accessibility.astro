---
import { entity } from '../config';

/* Physical effort, climate and crowd notes — a hill-top monument needs them. */
const notes = [
  {
    t: 'ସିଢ଼ି ଓ ଶାରୀରିକ ପରିଶ୍ରମ',
    d: 'ସ୍ତୂପ ପାହାଡ଼ ଶୀର୍ଷରେ; ଯାନ ରଖିବା ସ୍ଥାନରୁ ଏକ ସିଢ଼ିଯୁକ୍ତ ରାସ୍ତା ଉପରକୁ ଯାଇଛି। ବୃଦ୍ଧ ଓ ଶିଶୁଙ୍କ ସହିତ ହେଲେ ଧୀରେ ଚାଲନ୍ତୁ ଏବଂ ମଝିରେ ବିଶ୍ରାମ ନିଅନ୍ତୁ। ହ୍ୱିଲ୍‌ଚେୟାର୍ ପାଇଁ ଢାଲୁ/ରାମ୍ପ୍‌ର ଉପଲବ୍ଧତା ସୀମିତ—ପୂର୍ବରୁ ସ୍ଥାନୀୟ ସୂଚନା ନିଅନ୍ତୁ।',
    h: 'ମଧ୍ୟମ ପରିଶ୍ରମ',
  },
  {
    t: 'ଗ୍ରୀଷ୍ମ ଓ ସୂର୍ଯ୍ୟତାପ',
    d: 'ମାର୍ଚ୍ଚରୁ ଜୁନ୍ ମଧ୍ୟାହ୍ନରେ ପ୍ରବଳ ଗରମ ହୁଏ। ପାଣି ବୋତଲ, ଟୋପି ବା ଛତା ଏବଂ ହାଲୁକା ସୂତା କପଡ଼ା ବ୍ୟବହାର କରନ୍ତୁ; ଖାଲି ପାଦରେ ପଥର ଉପରେ ଚାଲିବା କଷ୍ଟକର ହୋଇପାରେ।',
    h: 'ସକାଳ/ସନ୍ଧ୍ୟା ଭଲ',
  },
  {
    t: 'ବର୍ଷା ଋତୁ',
    d: 'ଜୁନ୍–ସେପ୍ଟେମ୍ବର ମୌସୁମୀରେ ସିଢ଼ି ଓ ପଥର ପୃଷ୍ଠ ଖସଡ଼ା ହୋଇଯାଏ। ଅଣ-ସ୍ଲିପ୍ ଜୋତା ପିନ୍ଧନ୍ତୁ ଏବଂ ବଜ୍ରପାତ ସମୟରେ ଖୋଲା ଛାତ ଉପରେ ଠିଆ ହୁଅନ୍ତୁ ନାହିଁ।',
    h: 'ସାବଧାନତା ଆବଶ୍ୟକ',
  },
  {
    t: 'ଭିଡ଼ ଓ ଶାନ୍ତ ସମୟ',
    d: 'ସପ୍ତାହାନ୍ତ, ସରକାରୀ ଛୁଟି ଏବଂ ବୁଦ୍ଧ ପୂର୍ଣ୍ଣିମା ପରି ଦିନରେ ଭିଡ଼ ବଢ଼େ। ଶାନ୍ତିପୂର୍ଣ୍ଣ ଦର୍ଶନ ଓ ଫଟୋଗ୍ରାଫି ପାଇଁ ସୂର୍ଯ୍ୟୋଦୟ ପରବର୍ତ୍ତୀ ପ୍ରଥମ ଘଣ୍ଟା ସର୍ବୋତ୍ତମ।',
    h: 'ସକାଳକୁ ବାଛନ୍ତୁ',
  },
];
---

<section id="access" class="section">
  <div class="wrap">
    <p class="eyebrow">ଶାରୀରିକ ପ୍ରସ୍ତୁତି</p>
    <h2 class="title">ପାହାଡ଼ ଉପରକୁ ଯିବା ପୂର୍ବରୁ<span class="h2-alt">Access, Effort & Safety at {entity.shortName}</span></h2>
    <div class="access-grid">
      {notes.map((n) => (
        <article class="card fac-card">
          <h3>{n.t}</h3>
          <p>{n.d}</p>
          <span class="hint">{n.h}</span>
        </article>
      ))}
    </div>
    <p class="neutral-note">ଉପରୋକ୍ତ ସୂଚନା ସାଧାରଣ ଯାତ୍ରୀଙ୍କ ଅଭିଜ୍ଞତା ଓ ସାର୍ବଜନୀନ ସୂତ୍ର ଉପରେ ଆଧାରିତ; ନିର୍ଦ୍ଦିଷ୍ଟ ଆବଶ୍ୟକତା (ହ୍ୱିଲ୍‌ଚେୟାର୍, ଶିଶୁ ଗାଡ଼ି, ଚିକିତ୍ସାଗତ ସୀମାବଦ୍ଧତା) ଥିଲେ ଯାତ୍ରା ପୂର୍ବରୁ <a href={entity.sources[2].url} target="_blank" rel="noopener noreferrer">ସ୍ଥାନୀୟ ପ୍ରଶାସନ</a>ଙ୍କଠାରୁ ନିଶ୍ଚିତ କରନ୍ତୁ।</p>
  </div>
</section>
