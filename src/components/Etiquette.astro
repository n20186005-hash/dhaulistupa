---
import { entity } from '../config';

/* A Buddhist monument and an epigraph site at once: behaviour that protects both. */
const dos = [
  'କାନ୍ଧ ଓ ଆଣ୍ଠୁ ଘୋଡ଼ାଇ ରଖୁଥିବା ସାଧାରଣ ପୋଷାକ ପିନ୍ଧନ୍ତୁ—ଏହା ଏକ ସକ୍ରିୟ ପୂଜା ସ୍ଥଳ।',
  'ସ୍ତୂପ ପରିକ୍ରମା ଓ ପ୍ରାର୍ଥନା ସ୍ଥଳରେ ଶାନ୍ତ ରୁହନ୍ତୁ; ମୋବାଇଲ୍‌କୁ ସାଇଲେଣ୍ଟ୍ ମୋଡ୍‌ରେ ରଖନ୍ତୁ।',
  'ସ୍ଥାନୀୟ ସଙ୍କେତରେ ଦର୍ଶାଇଥିଲେ ନିର୍ଦ୍ଦିଷ୍ଟ ସ୍ଥାନରେ ଜୋତା ବାହାର କରନ୍ତୁ।',
  'ଧ୍ୟାନ ବା ପ୍ରାର୍ଥନାରତ ବ୍ୟକ୍ତିଙ୍କ ଫଟୋ ଉଠାଇବା ପୂର୍ବରୁ ଅନୁମତି ନିଅନ୍ତୁ।',
  'ନିଜର ଆବର୍ଜନା ନିଜେ ବାହାରକୁ ନେଇଯାଆନ୍ତୁ; ପାହାଡ଼ରେ ଡଷ୍ଟବିନ୍ ସୀମିତ।',
  'ପିଲା ଓ ବୟସ୍କ ସାଥୀଙ୍କୁ ସିଢ଼ି ଓ ଢାଲୁ ଅଂଶରେ ସାହାଯ୍ୟ କରନ୍ତୁ।',
];

const donts = [
  'ଶିଳାଲେଖ, ପଥର ହାତୀ ବା ରିଲିଫ୍ ପ୍ୟାନେଲ୍ ଉପରେ ଚଢ଼ନ୍ତୁ ନାହିଁ କିମ୍ବା ଛୁଅନ୍ତୁ ନାହିଁ—ଏଗୁଡ଼ିକ ସଂରକ୍ଷିତ ପ୍ରାଚୀନ ଅବଶେଷ।',
  'ପ୍ରାଚୀନ ପଥରରେ ନାମ ଖୋଦନ, ରଙ୍ଗ ବା ଚିହ୍ନ କରନ୍ତୁ ନାହିଁ; ଏହା ସ୍ମାରକ ସଂରକ୍ଷଣ ନିୟମର ଉଲ୍ଲଙ୍ଘନ।',
  'ଉଚ୍ଚ ସ୍ୱରରେ ସଙ୍ଗୀତ ବଜାନ୍ତୁ ନାହିଁ କିମ୍ବା ଭିଡ଼ରେ ଗହଳି କରନ୍ତୁ ନାହିଁ।',
  'ବିନା ଲିଖିତ ଅନୁମତିରେ ଡ୍ରୋନ୍ ଉଡ଼ାନ୍ତୁ ନାହିଁ କିମ୍ବା ବ୍ୟବସାୟିକ ଶୁଟିଂ କରନ୍ତୁ ନାହିଁ।',
  'ସ୍ତୂପ ପ୍ରାଙ୍ଗଣରେ ଧୂମପାନ ଓ ମାଂସାହାରୀ ଖାଦ୍ୟ ବାରଣ ଥାଇପାରେ—ସଙ୍କେତ ମାନନ୍ତୁ।',
  'ପଥର, ମାଟି ବା କୌଣସି ପ୍ରାଚୀନ ଅଂଶକୁ ସ୍ମାରକୀ ଭାବେ ସାଥରେ ନିଅନ୍ତୁ ନାହିଁ।',
];
---

<section id="etiquette" class="section">
  <div class="wrap">
    <p class="eyebrow">ଶିଷ୍ଟାଚାର ଓ ସଂରକ୍ଷଣ</p>
    <h2 class="title">ଭ୍ରମଣ ନିୟମ<span class="h2-alt">Etiquette & Preservation Guidelines at {entity.fullName}</span></h2>
    <p class="lead">ଧଉଳି ଏକାସାଙ୍ଗରେ ଏକ ସକ୍ରିୟ ବୌଦ୍ଧ ସ୍ମାରକ ଏବଂ ଏକ ସଂରକ୍ଷିତ ପ୍ରାଚୀନ ଶିଳାଲେଖ ସ୍ଥଳ। ନିମ୍ନଲିଖିତ ନିୟମ ଉଭୟଙ୍କୁ ସୁରକ୍ଷିତ ରଖିବାରେ ସାହାଯ୍ୟ କରେ।</p>
    <div class="etiquette">
      <article class="card do-dont">
        <h3>କରନ୍ତୁ · Do</h3>
        <ul>{dos.map((d) => <li>{d}</li>)}</ul>
      </article>
      <article class="card do-dont">
        <h3>କରନ୍ତୁ ନାହିଁ · Don't</h3>
        <ul>{donts.map((d) => <li>{d}</li>)}</ul>
      </article>
    </div>
  </div>
</section>
